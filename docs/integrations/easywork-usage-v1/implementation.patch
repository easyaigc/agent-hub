+import type { RuntimeTarget } from './agent-management.js';
+export declare const USAGE_VERSION: 1;
+export declare const USAGE_CAPABILITY: "usage:read:v1";
+export declare const USAGE_MAX_BYTES: number;
+export type UsageTarget = Readonly<Pick<RuntimeTarget, 'agentId' | 'hostId' | 'workspaceId' | 'runtimeId'>>;
+export type UsageReason = 'not-returned' | 'unsupported' | 'not-authenticated' | 'forbidden' | 'timeout' | 'offline' | 'upstream-error' | 'invalid-data' | 'unsupported-version';
+export type UsageUnit = {
+    kind: 'credits' | 'compute' | 'tokens' | 'requests' | 'currency' | 'custom';
+    code: string;
+    label: string;
+};
+export type UsageAppliesTo = {
+    kind: 'all';
+} | {
+    kind: 'models' | 'features';
+    ids: readonly string[];
+};
+export interface UsageMetricBase {
+    id: string;
+    label: string;
+    appliesTo: UsageAppliesTo;
+    observedAt: string;
+    validUntil: string;
+}
+export type UsageMeasure = {
+    kind: 'percentage';
+    usedPercent: number;
+} | {
+    kind: 'quantity';
+    used: string;
+    limit: string;
+    unit: UsageUnit;
+};
+export type UsageLimitReading = {
+    state: 'measured';
+    usage: UsageMeasure;
+} | {
+    state: 'unlimited';
+} | {
+    state: 'unavailable';
+    reason: UsageReason;
+};
+export type UsageBalanceReading = {
+    state: 'amount';
+    amount: string;
+    entitlement: 'finite' | 'unlimited' | 'unknown';
+} | {
+    state: 'unlimited';
+} | {
+    state: 'unavailable';
+    reason: UsageReason;
+};
+export type UsageMetric = UsageMetricBase & ({
+    kind: 'balance';
+    unit: UsageUnit;
+    reading: UsageBalanceReading;
+    expiresAt: string | null;
+} | {
+    kind: 'window-limit';
+    window: {
+        durationSeconds: number | null;
+        resetsAt: string | null;
+        resetPolicy: 'fixed' | 'rolling' | 'provider-defined' | 'unknown';
+    };
+    reading: UsageLimitReading;
+} | {
+    kind: 'capacity-limit';
+    reading: UsageLimitReading;
+} | {
+    kind: 'extension';
+    namespace: string;
+    extensionVersion: number;
+    valueText: string | null;
+    note: string | null;
+});
+export interface UsageIssue {
+    bucketId: string | null;
+    metricId: string | null;
+    reason: UsageReason;
+}
+export interface UsageBucket {
+    id: string;
+    label: string | null;
+    sharedPoolRef: string | null;
+    combination: {
+        kind: 'all-of' | 'any-of';
+        metricIds: readonly string[];
+    } | {
+        kind: 'provider-defined';
+    };
+    metrics: readonly UsageMetric[];
+}
+export interface UsageSnapshot {
+    snapshotId: string;
+    sampledAt: string;
+    source: {
+        adapterId: string;
+        scopeRef: string | null;
+        scopeLabel: string | null;
+        planLabel: string | null;
+    };
+    coverage: 'complete' | 'partial';
+    buckets: readonly UsageBucket[];
+    issues: readonly UsageIssue[];
+}
+export type UsageResponse = {
+    schemaVersion: 1;
+    target: UsageTarget;
+    requestId: string;
+} & ({
+    status: 'ok';
+    snapshot: UsageSnapshot;
+} | {
+    status: 'unavailable';
+    reason: UsageReason;
+});
+export interface UsageProvider {
+    readonly descriptor: {
+        id: typeof USAGE_CAPABILITY;
+        version: 1;
+        metricKinds: readonly UsageMetric['kind'][];
+        updates: 'push' | 'poll';
+    };
+    read(input: {
+        target: UsageTarget;
+        requestId: string;
+        signal: {
+            readonly aborted: boolean;
+        };
+    }): Promise<UsageResponse>;
+}
+export declare const usageReasons: readonly UsageReason[];
+/** Source decimals can be normalized losslessly. Wire decimals must already be canonical. */
+export declare function normalizeUsageDecimal(value: string): string;
+export declare function usageTarget(target: RuntimeTarget): UsageTarget;
+export declare function parseUsageTarget(value: unknown): UsageTarget;
+export declare function usageTargetKey(target: UsageTarget): string;
+/** Validate a single known metric at its element boundary. */
+export declare function parseUsageMetric(value: unknown): UsageMetric;
+/** Unknown v1 metrics may be skipped by a forward-compatible reader; known malformed data never passes. */
+export declare function parseUsageResponse(value: unknown, tolerateUnknownMetrics?: boolean): UsageResponse;
+export declare function unavailableUsage(target: UsageTarget, requestId: string, reason: UsageReason): UsageResponse;
