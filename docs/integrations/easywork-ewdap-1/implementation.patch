+import { randomUUID } from "node:crypto"
+import { readFile } from "node:fs/promises"
+import path from "node:path"
+
+import { openDeviceAuthorizationDelivery } from "@easyai-desktop/remote-access"
+import { afterEach, expect, test, vi } from "vitest"
+
+import { DesktopDeviceAuthorizationClient } from "../../../src/main/remote-access/desktop-device-authorization.js"
+import { DesktopRemoteRequestJournal } from "../../../src/main/remote-access/desktop-remote-request-journal.js"
+import {
+  createDeviceAuthorizationHttpFixture,
+  grantPayloadSchema,
+  type DeviceAuthorizationHttpFixture,
+} from "../../../../remote-access-service/test/support/device-authorization-fixture.js"
+
+let fixture: DeviceAuthorizationHttpFixture | undefined
+afterEach(async () => {
+  await fixture?.close()
+  fixture = undefined
+})
+async function setup() {
+  fixture = await createDeviceAuthorizationHttpFixture("local")
+  return fixture
+}
+function client(f: DeviceAuthorizationHttpFixture, onLocalRevoked = vi.fn(async () => undefined)) {
+  let offline = false
+  const requests: string[] = []
+  const instance = new DesktopDeviceAuthorizationClient({
+    context: async () => ({
+      privateKey: f.desktopKeys.privateKey,
+      identity: f.desktop,
+      target: f.target,
+    }),
+    statePath: path.join(f.directory, "desktop.json"),
+    request: async (pathname, init) => {
+      requests.push(pathname)
+      if (offline) throw new Error("fixture network unavailable")
+      const response = await f.desktopRequest(
+        pathname,
+        init?.method ?? "GET",
+        init?.body ? JSON.parse(String(init.body)) : undefined
+      )
+      if (!response.ok) throw new Error(`HTTP ${response.status}`)
+      return await response.json()
+    },
+    onLocalRevoked,
+  })
+  return {
+    instance,
+    requests,
+    setOffline: (value: boolean) => {
+      offline = value
+    },
+  }
+}
+test("Desktop decrypts its own offer and confirms a readable mobile claim through real HTTP", async () => {
+  const f = await setup(),
+    desktop = client(f)
+  const offer = await desktop.instance.createOffer()
+  expect(offer.connectionCode).toMatch(/^[0-9A-HJKMNP-TV-Z]{16}$/u)
+  const claim = await f.claim(offer.connectionCode!)
+  const waiting = await desktop.instance.refresh()
+  expect(waiting?.claim?.device.name).toBe("Synthetic Android")
+  expect(waiting?.claim?.verificationCode).toBe(claim.view.verificationCode)
+  await desktop.instance.decide(claim.view.claimId, "approve", claim.view.transcriptHash!)
+  expect((await desktop.instance.refresh())?.status).toBe("approved")
+  const delivered = (await (
+    await f.request(
+      `/v2/remote-access/pairing/claims/${claim.view.claimId}`,
+      "GET",
+      claim.pendingToken
+    )
+  ).json()) as { sealedDelivery: string }
+  const grant = grantPayloadSchema.parse(
+    await openDeviceAuthorizationDelivery(
+      f.mobileKeys.privateKey,
+      delivered.sealedDelivery,
+      claim.view.claimId
+    )
+  )
+  expect((await desktop.instance.assertBinding(grant.binding)).grant.grantId).toBe(grant.grantId)
+  await desktop.instance.revoke(grant.binding)
+  expect((await desktop.instance.refresh())?.status).toBe("revoked")
+})
+test("Desktop rejection does not issue a grant", async () => {
+  const f = await setup(),
+    desktop = client(f),
+    offer = await desktop.instance.createOffer()
+  const claim = await f.claim(offer.connectionCode!)
+  await desktop.instance.decide(claim.view.claimId, "reject", claim.view.transcriptHash!)
+  expect((await desktop.instance.refresh())?.status).toBe("rejected")
+  const status = (await (
+    await f.request(
+      `/v2/remote-access/pairing/claims/${claim.view.claimId}`,
+      "GET",
+      claim.pendingToken
+    )
+  ).json()) as { status: string; sealedDelivery?: string }
+  expect(status.status).toBe("rejected")
+  expect(status.sealedDelivery).toBeUndefined()
+})
+test("local revocation is durable before a failed Relay request and cannot revive after Host restart", async () => {
+  const f = await setup(),
+    { grant } = await f.approved(),
+    revoked = vi.fn(async () => undefined)
+  const desktop = client(f, revoked)
+  desktop.setOffline(true)
+  await expect(desktop.instance.revoke(grant.binding)).rejects.toThrow("network unavailable")
+  expect(revoked).toHaveBeenCalledWith(grant.binding.bindingId)
+  const restored = client(f)
+  const before = restored.requests.length
+  await expect(restored.instance.assertBinding(grant.binding)).rejects.toThrow("本电脑撤销")
+  expect(restored.requests.length).toBe(before)
+  await restored.instance.revoke(grant.binding)
+  expect((await f.request("/v2/remote-access/bindings", "GET", grant.accessToken)).status).toBe(403)
+})
+test("new account/target cannot reuse an older binding or reveal the previous offer", async () => {
+  const f = await setup(),
+    { grant } = await f.approved()
+  await client(f).instance.createOffer()
+  const desktop = new DesktopDeviceAuthorizationClient({
+    context: async () => ({
+      privateKey: f.foreignKeys.privateKey,
+      identity: f.foreignDesktop,
+      target: {
+        ...f.target,
+        account: f.foreignDesktop.account,
+        desktopDeviceId: f.foreignDesktop.deviceId,
+      },
+    }),
+    statePath: path.join(f.directory, "desktop.json"),
+    onLocalRevoked: async () => undefined,
+    request: async () => {
+      throw new Error("must not contact another target")
+    },
+  })
+  await expect(desktop.assertBinding(grant.binding)).rejects.toThrow("当前账户")
+  expect(await desktop.refresh()).toBeUndefined()
+  expect(desktop.getOffer()).toBeUndefined()
+})
+test("durable model-operation receipt merges transport retries, survives restart and rejects another intent", async () => {
+  const f = await setup(),
+    file = path.join(f.directory, "model-receipts.json")
+  const journal = new DesktopRemoteRequestJournal(file)
+  const request = {
+    protocolVersion: 2 as const,
+    kind: "request" as const,
+    target: f.target,
+    requestId: randomUUID(),
+    method: "runtime/context" as const,
+    params: {},
+  }
+  const result = {
+    protocolVersion: 2 as const,
+    kind: "response" as const,
+    requestId: request.requestId,
+    ok: true as const,
+    result: { durable: true },
+  }
+  const dispatch = vi.fn(async () => result)
+  expect(
+    await Promise.all([journal.execute(request, dispatch), journal.execute(request, dispatch)])
+  ).toEqual([result, result])
+  expect(dispatch).toHaveBeenCalledTimes(1)
+  const restarted = new DesktopRemoteRequestJournal(file)
+  expect(await restarted.execute(request, dispatch)).toEqual(result)
+  expect(dispatch).toHaveBeenCalledTimes(1)
+  expect(
+    await restarted.execute({ ...request, method: "runtime/summary" }, dispatch)
+  ).toMatchObject({ ok: false, error: { code: "REMOTE_OPERATION_CONFLICT" } })
+})
+test("a dispatched operation with unknown outcome never repeats after restart", async () => {
+  const f = await setup(),
+    file = path.join(f.directory, "unknown-receipts.json")
+  const request = {
+    protocolVersion: 2 as const,
+    kind: "request" as const,
+    target: f.target,
+    requestId: randomUUID(),
+    method: "runtime/context" as const,
+    params: {},
+  }
+  const journal = new DesktopRemoteRequestJournal(file)
+  const result = {
+    protocolVersion: 2 as const,
+    kind: "response" as const,
+    requestId: request.requestId,
+    ok: true as const,
+    result: {},
+  }
+  let resolve!: (value: typeof result) => void
+  const dispatched = vi.fn(
+    () =>
+      new Promise<typeof result>((done) => {
+        resolve = done
+      })
+  )
+  const running = journal.execute(request, dispatched)
+  await vi.waitFor(() => expect(dispatched).toHaveBeenCalledTimes(1))
+  const restored = new DesktopRemoteRequestJournal(file),
+    duplicate = vi.fn(async () => result)
+  expect(await restored.execute(request, duplicate)).toMatchObject({
+    ok: false,
+    error: { code: "REMOTE_OPERATION_OUTCOME_UNKNOWN" },
+  })
+  expect(duplicate).not.toHaveBeenCalled()
+  expect(await readFile(file, "utf8")).toContain("dispatching")
+  resolve(result)
+  await running
+})
