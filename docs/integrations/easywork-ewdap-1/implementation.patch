+++ b/apps/remote-access-service/test/support/device-authorization-fixture.ts
@@ -0,0 +1,339 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process"
+import { once } from "node:events"
+import { mkdtemp, mkdir } from "node:fs/promises"
+import path from "node:path"
+import { createInterface } from "node:readline"
+import { randomUUID } from "node:crypto"
+
+import {
+  createRemoteIdentityKeyPair,
+  deviceAuthorizationPublicJwkSchema,
+  deviceDescriptorSchema,
+  openDeviceAuthorizationDelivery,
+  remoteBindingSchema,
+  type RemoteBinding,
+  type RemoteDeviceIdentity,
+} from "@easyai-desktop/remote-access"
+import { generateKeyPair, exportJWK, SignJWT } from "jose"
+import postgres from "postgres"
+import { z } from "zod"
+
+import { hashDeviceAuthorizationValue } from "../../src/device-authorization/crypto.js"
+import type { EwdapHttpWorkerConfiguration } from "./device-authorization-worker.js"
+import { claimResponseSchema } from "../../src/device-authorization/records.js"
+
+const grantPayloadSchema = z.object({
+  protocol: z.literal("EWDAP/1"),
+  deliveryId: z.string(),
+  grantId: z.string(),
+  deviceId: z.string(),
+  binding: remoteBindingSchema,
+  target: z.unknown(),
+  keyVersion: z.number(),
+  scopes: z.array(z.string()),
+  accessToken: z.string(),
+  accessExpiresAt: z.string(),
+  refreshToken: z.string(),
+  refreshExpiresAt: z.string(),
+})
+export class DeviceAuthorizationHttpFixture {
+  readonly desktopKeys = createRemoteIdentityKeyPair()
+  readonly mobileKeys = createRemoteIdentityKeyPair()
+  readonly foreignKeys = createRemoteIdentityKeyPair()
+  readonly desktop: RemoteDeviceIdentity
+  readonly foreignDesktop: RemoteDeviceIdentity
+  readonly target: RemoteBinding["target"]
+  readonly directory: string
+  clock = Date.now()
+  origin = ""
+  process?: ChildProcessWithoutNullStreams
+  signing?: Awaited<ReturnType<typeof generateKeyPair>>
+  authPublicKey?: z.infer<typeof deviceAuthorizationPublicJwkSchema>
+  readonly mobileId = randomUUID()
+  readonly databaseUrl?: string
+  #pending = new Map<string, { resolve: () => void; reject: (error: Error) => void }>()
+  #errors = ""
+  constructor(directory: string, databaseUrl?: string) {
+    this.directory = directory
+    this.databaseUrl = databaseUrl
+    this.desktop = {
+      account: { authority: "https://fixture.invalid", subject: randomUUID() },
+      deviceId: randomUUID(),
+      platform: "desktop",
+      publicKey: this.desktopKeys.publicKey,
+    }
+    this.foreignDesktop = {
+      account: { authority: "https://foreign.fixture.invalid", subject: randomUUID() },
+      deviceId: randomUUID(),
+      platform: "desktop",
+      publicKey: this.foreignKeys.publicKey,
+    }
+    this.target = {
+      account: this.desktop.account,
+      desktopDeviceId: this.desktop.deviceId,
+      workspaceId: randomUUID(),
+      runtimeId: "local",
+    }
+  }
+  async start() {
+    if (!this.signing) {
+      this.signing = await generateKeyPair("ES256", { extractable: true })
+      const publicJwk = await exportJWK(this.signing.publicKey)
+      this.authPublicKey = deviceAuthorizationPublicJwkSchema.parse({
+        kty: publicJwk.kty,
+        crv: publicJwk.crv,
+        x: publicJwk.x,
+        y: publicJwk.y,
+      })
+    }
+    const process = spawn(
+      "bun",
+      [path.resolve("apps/remote-access-service/test/support/device-authorization-worker.ts")],
+      { stdio: ["pipe", "pipe", "pipe"], cwd: path.resolve(".") }
+    )
+    this.process = process
+    process.stderr.on("data", (data: Buffer) => {
+      this.#errors += data.toString().slice(0, 2_000)
+    })
+    const lines = createInterface({ input: process.stdout })
+    await new Promise<void>((resolve, reject) => {
+      const timeout = setTimeout(() => {
+        reject(new Error("EWDAP HTTP worker startup timeout: " + this.#errors))
+        process.kill("SIGTERM")
+      }, 15_000)
+      process.once("exit", (code) => {
+        clearTimeout(timeout)
+        const error = new Error("EWDAP HTTP worker stopped before fixture command completed")
+        for (const pending of this.#pending.values()) pending.reject(error)
+        this.#pending.clear()
+        if (!this.origin || code) reject(new Error("EWDAP HTTP worker failed: " + this.#errors))
+      })
+      lines.on("line", (line) => {
+        // PostgreSQL may write multiline notices to stdout; they are not fixture IPC.
+        const prefix = "ewdap-fixture-v1:"
+        if (!line.startsWith(prefix)) return
+        try {
+          const data = z
+            .discriminatedUnion("kind", [
+              z.object({ kind: z.literal("ready"), origin: z.url(), pid: z.number() }).strict(),
+              z.object({ kind: z.literal("ack"), id: z.uuid() }).strict(),
+            ])
+            .parse(JSON.parse(line.slice(prefix.length)))
+          if (data.kind === "ready") {
+            this.origin = data.origin
+            clearTimeout(timeout)
+            resolve()
+          } else {
+            this.#pending.get(data.id)?.resolve()
+            this.#pending.delete(data.id)
+          }
+        } catch {
+          const error = new Error("invalid EWDAP fixture IPC event")
+          for (const pending of this.#pending.values()) pending.reject(error)
+          this.#pending.clear()
+          reject(error)
+          process.kill("SIGTERM")
+        }
+      })
+      const workerConfiguration: EwdapHttpWorkerConfiguration = {
+        directory: this.directory,
+        databaseUrl: this.databaseUrl,
+        desktop: this.desktop,
+        foreignDesktop: this.foreignDesktop,
+        clock: this.clock,
+      }
+      process.stdin.write(JSON.stringify(workerConfiguration) + "\n")
+    })
+  }
+  async close() {
+    if (!this.process) return
+    const exit = once(this.process, "exit")
+    this.process.kill("SIGTERM")
+    const stopped = this.process
+    const deadline = setTimeout(() => stopped.kill("SIGKILL"), 3_000)
+    try {
+      await exit
+    } finally {
+      clearTimeout(deadline)
+    }
+    this.process = undefined
+  }
+  async restart() {
+    await this.close()
+    this.origin = ""
+    await this.start()
+  }
+  async command(command: object) {
+    const id = randomUUID()
+    await new Promise<void>((resolve, reject) => {
+      this.#pending.set(id, { resolve, reject })
+      this.process!.stdin.write(JSON.stringify({ id, ...command }) + "\n")
+    })
+  }
+  async advance(ms: number) {
+    this.clock += ms
+    await this.command({ clock: this.clock })
+  }
+  async proof(
+    pathname: string,
+    method: string,
+    token?: string,
+    body?: string,
+    overrides?: Record<string, unknown>,
+    signing = this.signing!
+  ) {
+    const raw = await exportJWK(signing.publicKey)
+    const jwk = { kty: raw.kty, crv: raw.crv, x: raw.x, y: raw.y }
+    return await new SignJWT({
+      htm: method,
+      htu: new URL(pathname, this.origin).href,
+      iat: Math.floor(this.clock / 1_000),
+      jti: randomUUID(),
+      ...(token ? { ath: hashDeviceAuthorizationValue(token) } : {}),
+      ...(body ? { bht: hashDeviceAuthorizationValue(body) } : {}),
+      ...overrides,
+    })
+      .setProtectedHeader({ typ: "dpop+jwt", alg: "ES256", jwk })
+      .sign(signing.privateKey)
+  }
+  async request(
+    pathname: string,
+    method = "GET",
+    token?: string,
+    value?: unknown,
+    options?: {
+      proof?: string
+      overrides?: Record<string, unknown>
+      signing?: Awaited<ReturnType<typeof generateKeyPair>>
+    }
+  ) {
+    const body = value === undefined ? undefined : JSON.stringify(value)
+    const proof =
+      options?.proof ??
+      (await this.proof(pathname, method, token, body, options?.overrides, options?.signing))
+    return await fetch(new URL(pathname, this.origin), {
+      method,
+      headers: {
+        "Content-Type": "application/json",
+        DPoP: proof,
+        ...(token ? { Authorization: `DPoP ${token}` } : {}),
+      },
+      ...(body ? { body } : {}),
+    })
+  }
+  async desktopRequest(pathname: string, method = "GET", value?: unknown, foreign = false) {
+    return await fetch(new URL(pathname, this.origin), {
+      method,
+      headers: {
+        Authorization: `Bearer ${foreign ? "fixture-foreign-desktop" : "fixture-desktop"}`,
+        "Content-Type": "application/json",
+      },
+      ...(value ? { body: JSON.stringify(value) } : {}),
+    })
+  }
+  async offer() {
+    const response = await this.desktopRequest("/v2/remote-access/pairing/offers", "POST", {
+      operationId: randomUUID(),
+      target: this.target,
+    })
+    if (response.status !== 201) throw new Error(`offer failed HTTP ${response.status}`)
+    const view = z
+      .object({ offerId: z.string(), sealedDescriptor: z.string() })
+      .passthrough()
+      .parse(await response.json())
+    return {
+      view,
+      descriptor: deviceDescriptorSchema.parse(
+        await openDeviceAuthorizationDelivery(
+          this.desktopKeys.privateKey,
+          view.sealedDescriptor,
+          view.offerId
+        )
+      ),
+    }
+  }
+  claimBody(connectionCode: string, operationId: string = randomUUID()) {
+    return {
+      operationId,
+      connectionCode,
+      device: {
+        deviceId: this.mobileId,
+        platform: "android" as const,
+        name: "Synthetic Android",
+        publicKey: this.mobileKeys.publicKey,
+        authPublicKey: this.authPublicKey!,
+      },
+    }
+  }
+  async claim(connectionCode: string, operationId?: string) {
+    const body = this.claimBody(connectionCode, operationId)
+    const response = await this.request("/v2/remote-access/pairing/claims", "POST", undefined, body)
+    if (response.status !== 201) throw new Error(`claim failed HTTP ${response.status}`)
+    const view = claimResponseSchema.parse(await response.json())
+    const pending = z
+      .object({ pendingToken: z.string() })
+      .passthrough()
+      .parse(
+        await openDeviceAuthorizationDelivery(
+          this.mobileKeys.privateKey,
+          view.sealedDelivery!,
+          view.claimId
+        )
+      )
+    return { body, view, pendingToken: pending.pendingToken }
+  }
+  async approved() {
+    const offer = await this.offer(),
+      claim = await this.claim(offer.descriptor.connectionCode)
+    const viewResponse = await this.desktopRequest(
+      `/v2/remote-access/pairing/offers/${offer.view.offerId}`
+    )
+    const view = z
+      .object({ claim: z.object({ transcriptHash: z.string() }).passthrough() })
+      .passthrough()
+      .parse(await viewResponse.json())
+    const response = await this.desktopRequest(
+      `/v2/remote-access/pairing/claims/${claim.view.claimId}/decision`,
+      "POST",
+      { operationId: randomUUID(), decision: "approve", transcriptHash: view.claim.transcriptHash }
+    )
+    if (response.status !== 200) throw new Error(`decision failed HTTP ${response.status}`)
+    const status = await this.request(
+      `/v2/remote-access/pairing/claims/${claim.view.claimId}`,
+      "GET",
+      claim.pendingToken
+    )
+    const delivered = claimResponseSchema.parse(await status.json())
+    const grant = grantPayloadSchema.parse(
+      await openDeviceAuthorizationDelivery(
+        this.mobileKeys.privateKey,
+        delivered.sealedDelivery!,
+        claim.view.claimId
+      )
+    )
+    return { ...offer, claim, grant }
+  }
+}
+export async function createDeviceAuthorizationHttpFixture(storage: "local" | "postgres") {
+  await mkdir(path.resolve(".tmp/ewdap-acceptance"), { recursive: true, mode: 0o700 })
+  const directory = await mkdtemp(path.resolve(".tmp/ewdap-acceptance/http-"))
+  let databaseUrl: string | undefined
+  if (storage === "postgres") {
+    const configured = process.env.EWDAP_TEST_DATABASE_URL
+    if (!configured)
+      throw new Error("Independent EWDAP_TEST_DATABASE_URL required for PostgreSQL acceptance")
+    const url = new URL(configured)
+    if (url.hostname !== "127.0.0.1" || url.pathname !== "/ewdap_a5")
+      throw new Error("EWDAP PostgreSQL fixture requires its dedicated loopback database")
+    const schema = `ewdap_${randomUUID().replaceAll("-", "")}`
+    const connection = postgres(configured)
+    await connection.unsafe(`create schema ${schema}`)
+    await connection.end()
+    url.searchParams.set("options", `-c search_path=${schema}`)
+    databaseUrl = url.href
+  }
+  const fixture = new DeviceAuthorizationHttpFixture(directory, databaseUrl)
+  await fixture.start()
+  return fixture
+}
+export { grantPayloadSchema }
