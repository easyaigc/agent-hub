diff --git a/apps/remote-access-service/src/device-authorization/body.ts b/apps/remote-access-service/src/device-authorization/body.ts
new file mode 100644
index 0000000..1160cf9
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/body.ts
@@ -0,0 +1,42 @@
+import type { Context } from "hono"
+
+import { DeviceAuthorizationError } from "./crypto.js"
+
+/** Bound anonymous inputs before JSON allocation or public-key verification. */
+export async function readDeviceAuthorizationBody(
+  context: Context,
+  limit = 16 * 1_024 * 1_024
+): Promise<string> {
+  const size = Number(context.req.header("content-length"))
+  if (Number.isFinite(size) && size > limit)
+    throw new DeviceAuthorizationError("request_too_large", 413)
+  const reader = context.req.raw.body?.getReader()
+  if (!reader) return ""
+  const chunks: Uint8Array[] = []
+  let length = 0
+  try {
+    while (true) {
+      const result = await reader.read()
+      if (result.done) break
+      length += result.value.length
+      if (length > limit) {
+        await reader.cancel()
+        throw new DeviceAuthorizationError("request_too_large", 413)
+      }
+      chunks.push(result.value)
+    }
+  } finally {
+    reader.releaseLock()
+  }
+  const bytes = new Uint8Array(length)
+  let offset = 0
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset)
+    offset += chunk.length
+  }
+  try {
+    return new TextDecoder("utf-8", { fatal: true }).decode(bytes)
+  } catch {
+    throw new DeviceAuthorizationError("invalid_request", 400)
+  }
+}
diff --git a/apps/remote-access-service/src/device-authorization/crypto.ts b/apps/remote-access-service/src/device-authorization/crypto.ts
new file mode 100644
index 0000000..bc6eb1c
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/crypto.ts
@@ -0,0 +1,122 @@
+import { createHash, createHmac, randomBytes, timingSafeEqual } from "node:crypto"
+
+import {
+  canonicalDeviceAuthorizationJson,
+  deviceAuthorizationPublicJwkSchema,
+  type DeviceAuthorizationPublicJwk,
+} from "@easyai-desktop/remote-access"
+import { calculateJwkThumbprint, decodeProtectedHeader, importJWK, jwtVerify } from "jose"
+import { z } from "zod"
+
+import type { DeviceAuthorizationStore } from "./store.js"
+
+export class DeviceAuthorizationError extends Error {
+  constructor(
+    readonly code: string,
+    readonly status = 401
+  ) {
+    super(code)
+    this.name = "DeviceAuthorizationError"
+  }
+}
+export const hashDeviceAuthorizationValue = (value: string) =>
+  createHash("sha256").update(value).digest("base64url")
+export const deviceAuthorizationIntent = (value: unknown) =>
+  hashDeviceAuthorizationValue(canonicalDeviceAuthorizationJson(value))
+export const deviceAuthorizationToken = () => randomBytes(32).toString("base64url")
+export const digestDeviceAuthorizationToken = (pepper: Uint8Array, value: string) =>
+  createHmac("sha256", pepper).update(value).digest("base64url")
+export function equalAuthorizationValue(left: string, right: string): boolean {
+  const a = Buffer.from(left),
+    b = Buffer.from(right)
+  return a.length === b.length && timingSafeEqual(a, b)
+}
+export function canonicalDeviceAuthorizationUrl(value: string): string {
+  const url = new URL(value)
+  url.search = ""
+  url.hash = ""
+  if (url.username || url.password || !["https:", "http:"].includes(url.protocol))
+    throw new DeviceAuthorizationError("invalid_dpop")
+  return url.href
+}
+const proofSchema = z
+  .object({
+    jti: z.string().min(16).max(128),
+    iat: z.number().int(),
+    htm: z.string(),
+    htu: z.string(),
+    ath: z.string().optional(),
+    bht: z.string().optional(),
+  })
+  .passthrough()
+export async function verifyDeviceAuthorizationProof(input: {
+  proof?: string
+  method: string
+  url: string
+  token?: string
+  bodyHash?: string
+  expectedJwk?: DeviceAuthorizationPublicJwk
+  now: Date
+  store: DeviceAuthorizationStore
+}): Promise<{ jwk: DeviceAuthorizationPublicJwk; thumbprint: string }> {
+  try {
+    if (!input.proof || input.proof.length > 8_192) throw new Error("missing proof")
+    const header = decodeProtectedHeader(input.proof)
+    if (
+      header.alg !== "ES256" ||
+      header.typ !== "dpop+jwt" ||
+      header.jku ||
+      header.x5u ||
+      header.crit
+    )
+      throw new Error("invalid proof header")
+    const jwk = deviceAuthorizationPublicJwkSchema.parse(header.jwk)
+    const thumbprint = await calculateJwkThumbprint(jwk)
+    if (
+      input.expectedJwk &&
+      !equalAuthorizationValue(thumbprint, await calculateJwkThumbprint(input.expectedJwk))
+    )
+      throw new Error("wrong key")
+    const key = await importJWK(jwk, "ES256")
+    const result = await jwtVerify(input.proof, key, {
+      algorithms: ["ES256"],
+      typ: "dpop+jwt",
+      currentDate: input.now,
+      clockTolerance: 5,
+    })
+    const payload = proofSchema.parse(result.payload)
+    const now = Math.floor(input.now.getTime() / 1_000)
+    if (
+      payload.iat < now - 60 ||
+      payload.iat > now + 5 ||
+      payload.htm !== input.method.toUpperCase() ||
+      payload.htu !== canonicalDeviceAuthorizationUrl(input.url)
+    )
+      throw new Error("proof request mismatch")
+    if (
+      input.token
+        ? !payload.ath ||
+          !equalAuthorizationValue(payload.ath, hashDeviceAuthorizationValue(input.token))
+        : payload.ath !== undefined
+    )
+      throw new Error("proof token mismatch")
+    if (
+      input.bodyHash
+        ? !payload.bht || !equalAuthorizationValue(payload.bht, input.bodyHash)
+        : payload.bht !== undefined
+    )
+      throw new Error("proof body mismatch")
+    const proofKey = `${thumbprint}:${payload.jti}`
+    await input.store.transaction([`proof:${proofKey}`], async (transaction) => {
+      if (await transaction.get("proofs", proofKey))
+        throw new DeviceAuthorizationError("dpop_replay")
+      await transaction.put("proofs", proofKey, {
+        expiresAt: new Date(input.now.getTime() + 70_000).toISOString(),
+      })
+    })
+    return { jwk, thumbprint }
+  } catch (error) {
+    if (error instanceof DeviceAuthorizationError) throw error
+    throw new DeviceAuthorizationError("invalid_dpop")
+  }
+}
diff --git a/apps/remote-access-service/src/device-authorization/http-app.ts b/apps/remote-access-service/src/device-authorization/http-app.ts
new file mode 100644
index 0000000..e96dcfd
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/http-app.ts
@@ -0,0 +1,345 @@
+import { readDeviceAuthorizationBody } from "./body.js"
+import {
+  deviceClaimRequestSchema,
+  deviceDecisionRequestSchema,
+  deviceOfferRequestSchema,
+  deviceOperationRequestSchema,
+  deviceAuthorizationTargetKey,
+  encryptedRelayEnvelopeSchema,
+  remoteBindingSchema,
+  EWDAP_PROTOCOL,
+  type DeviceAuthorizationScope,
+  type RemoteDeviceIdentity,
+} from "@easyai-desktop/remote-access"
+import { runtimeTargetSchema } from "@easyai-desktop/agent-protocol"
+import { Hono, type Context } from "hono"
+import { z } from "zod"
+
+import type { RemoteAuthVerifier } from "../auth.js"
+import type { RelayMailbox } from "../relay-mailbox.js"
+import type { EncryptedRelayGuard } from "@easyai-desktop/remote-access"
+import type { RemoteAccessFeaturePolicy } from "../operations.js"
+import {
+  DeviceAuthorizationError,
+  canonicalDeviceAuthorizationUrl,
+  hashDeviceAuthorizationValue,
+  verifyDeviceAuthorizationProof,
+} from "./crypto.js"
+import { DeviceAuthorizationService, type AuthorizedMobileDevice } from "./service.js"
+
+export type DeviceAuthorizationHttpOptions = {
+  service: DeviceAuthorizationService
+  authVerifier: RemoteAuthVerifier
+  externalOrigin: string
+  relayGuard: EncryptedRelayGuard
+  relayMailbox: RelayMailbox
+  featurePolicy?: RemoteAccessFeaturePolicy
+  onBindingRevoked?: (binding: z.infer<typeof remoteBindingSchema>) => Promise<void> | void
+  remoteAddress?: (context: Context) => string
+  presence?: { isOnline(deviceId: string): Promise<boolean> }
+}
+export function deviceAuthorizationOpaqueToken(authorization: string | undefined): string {
+  if (!authorization?.startsWith("DPoP ") || authorization.length > 200)
+    throw new DeviceAuthorizationError("unauthorized")
+  const token = authorization.slice(5)
+  if (!/^[A-Za-z0-9_-]{43}$/u.test(token)) throw new DeviceAuthorizationError("unauthorized")
+  return token
+}
+function expectedUrl(context: Context, externalOrigin: string) {
+  return new URL(new URL(context.req.url).pathname, externalOrigin).href
+}
+async function enabled(device: RemoteDeviceIdentity, policy?: RemoteAccessFeaturePolicy) {
+  if (device.integrity === "compromised")
+    throw new DeviceAuthorizationError("device_compromised", 403)
+  if (policy && !(await policy.isEnabled(device)))
+    throw new DeviceAuthorizationError("feature_disabled", 403)
+}
+export async function authenticateDeviceAuthorizationMobile(
+  context: Context,
+  options: DeviceAuthorizationHttpOptions,
+  body = ""
+) {
+  const token = deviceAuthorizationOpaqueToken(context.req.header("authorization"))
+  const jwk = await options.service.credentialKey(token, "access")
+  const proof = await verifyDeviceAuthorizationProof({
+    proof: context.req.header("DPoP"),
+    method: context.req.method,
+    url: expectedUrl(context, options.externalOrigin),
+    token,
+    ...(body ? { bodyHash: hashDeviceAuthorizationValue(body) } : {}),
+    expectedJwk: jwk,
+    now: options.service.now(),
+    store: options.service.store,
+  })
+  const principal = await options.service.authorize(token, proof.thumbprint)
+  await enabled(principal.identity, options.featurePolicy)
+  return { ...principal, token, thumbprint: proof.thumbprint }
+}
+export function assertDeviceAuthorizationScope(
+  principal: AuthorizedMobileDevice,
+  scope: DeviceAuthorizationScope
+) {
+  if (!principal.grant.scopes.includes(scope))
+    throw new DeviceAuthorizationError("scope_denied", 403)
+}
+export function createDeviceAuthorizationHttpApp(options: DeviceAuthorizationHttpOptions) {
+  const app = new Hono()
+  const service = options.service
+  app.use("*", async (context, next) => {
+    context.header("Cache-Control", "no-store")
+    await next()
+  })
+  const desktop = async (context: Context) => {
+    const header = context.req.header("authorization")
+    if (!header?.startsWith("Bearer ")) throw new DeviceAuthorizationError("unauthorized")
+    let identity: RemoteDeviceIdentity
+    try {
+      identity = await options.authVerifier.verifyBearerToken(header.slice(7))
+    } catch {
+      throw new DeviceAuthorizationError("unauthorized")
+    }
+    if (identity.platform !== "desktop") throw new DeviceAuthorizationError("desktop_required", 403)
+    await enabled(identity, options.featurePolicy)
+    return identity
+  }
+  app.post("/pairing/offers", async (context) => {
+    const identity = await desktop(context)
+    const request = deviceOfferRequestSchema.parse(
+      JSON.parse(await readDeviceAuthorizationBody(context, 16_384))
+    )
+    return context.json(await service.createOffer(identity, request), 201)
+  })
+  app.post("/pairing/claims", async (context) => {
+    // Rate limit the actual connection address, never a user-supplied forwarding header.
+    await service.rateLimit(`claim-ip:${options.remoteAddress?.(context) ?? "unknown"}`, 20, 60_000)
+    const body = await readDeviceAuthorizationBody(context, 8_192)
+    if (body.length > 8_192) throw new DeviceAuthorizationError("invalid_request", 400)
+    const request = deviceClaimRequestSchema.parse(JSON.parse(body))
+    const proof = await verifyDeviceAuthorizationProof({
+      proof: context.req.header("DPoP"),
+      method: "POST",
+      url: expectedUrl(context, options.externalOrigin),
+      bodyHash: hashDeviceAuthorizationValue(body),
+      expectedJwk: request.device.authPublicKey,
+      now: service.now(),
+      store: service.store,
+    })
+    await service.rateLimit(`claim-key:${proof.thumbprint}`, 5, 60_000)
+    return context.json(await service.claim(request, proof.thumbprint), 201)
+  })
+  app.get("/pairing/offers/:offerId", async (context) =>
+    context.json(await service.getOffer(context.req.param("offerId"), await desktop(context)))
+  )
+  app.get("/pairing/claims/:claimId", async (context) => {
+    const token = deviceAuthorizationOpaqueToken(context.req.header("authorization"))
+    const proof = await verifyDeviceAuthorizationProof({
+      proof: context.req.header("DPoP"),
+      method: "GET",
+      url: expectedUrl(context, options.externalOrigin),
+      token,
+      expectedJwk: await service.credentialKey(token, "pending"),
+      now: service.now(),
+      store: service.store,
+    })
+    return context.json(
+      await service.getClaim(context.req.param("claimId"), token, proof.thumbprint)
+    )
+  })
+  app.post("/pairing/claims/:claimId/decision", async (context) =>
+    context.json(
+      await service.decide(
+        context.req.param("claimId"),
+        await desktop(context),
+        deviceDecisionRequestSchema.parse(
+          JSON.parse(await readDeviceAuthorizationBody(context, 16_384))
+        )
+      )
+    )
+  )
+  app.post("/device-grants/refresh", async (context) => {
+    const body = await readDeviceAuthorizationBody(context),
+      request = deviceOperationRequestSchema.parse(JSON.parse(body))
+    const token = deviceAuthorizationOpaqueToken(context.req.header("authorization"))
+    const proof = await verifyDeviceAuthorizationProof({
+      proof: context.req.header("DPoP"),
+      method: "POST",
+      url: expectedUrl(context, options.externalOrigin),
+      token,
+      bodyHash: hashDeviceAuthorizationValue(body),
+      expectedJwk: await service.credentialKey(token, "refresh"),
+      now: service.now(),
+      store: service.store,
+    })
+    // Account/device feature restrictions must apply to refresh as well as mailbox access.
+    await enabled(await service.refreshIdentity(token, proof.thumbprint), options.featurePolicy)
+    const result = await service.refresh(token, proof.thumbprint, request.operationId)
+    return context.json(result)
+  })
+  app.delete("/device-grants/:grantId", async (context) => {
+    const body = await readDeviceAuthorizationBody(context),
+      request = deviceOperationRequestSchema.parse(JSON.parse(body))
+    const principal = context.req.header("authorization")?.startsWith("Bearer ")
+      ? await desktop(context)
+      : await (async () => {
+          const token = deviceAuthorizationOpaqueToken(context.req.header("authorization"))
+          const proof = await verifyDeviceAuthorizationProof({
+            proof: context.req.header("DPoP"),
+            method: "DELETE",
+            url: expectedUrl(context, options.externalOrigin),
+            token,
+            bodyHash: hashDeviceAuthorizationValue(body),
+            expectedJwk: await service.credentialKey(token, "access"),
+            now: service.now(),
+            store: service.store,
+          })
+          return await service.authorizeRevocation(
+            token,
+            proof.thumbprint,
+            context.req.param("grantId")
+          )
+        })()
+    const result = await service.revoke(
+      context.req.param("grantId"),
+      request.operationId,
+      principal
+    )
+    const state = await service.store.transaction([], async (transaction) =>
+      remoteBindingSchema.parse(await transaction.get("bindings", result.bindingId))
+    )
+    await options.onBindingRevoked?.(state)
+    return context.json(result)
+  })
+  app.get("/bindings/:bindingId/authorization", async (context) =>
+    context.json(
+      await service.bindingAuthorization(context.req.param("bindingId"), await desktop(context))
+    )
+  )
+  app.post("/device-grants/authorize-lan", async (context) => {
+    const identity = await desktop(context)
+    const request = z
+      .object({
+        bindingId: z.string(),
+        target: runtimeTargetSchema,
+        authorization: z.string().max(200),
+        proof: z.string().max(8_192),
+        method: z.enum(["GET", "POST", "PUT", "PATCH", "DELETE"]),
+        htu: z.url(),
+        bodyHash: z.string().optional(),
+      })
+      .strict()
+      .parse(JSON.parse(await readDeviceAuthorizationBody(context, 16_384)))
+    service.assertDesktop(identity, request.target)
+    const token = deviceAuthorizationOpaqueToken(request.authorization)
+    const proof = await verifyDeviceAuthorizationProof({
+      proof: request.proof,
+      method: request.method,
+      url: canonicalDeviceAuthorizationUrl(request.htu),
+      token,
+      ...(request.bodyHash ? { bodyHash: request.bodyHash } : {}),
+      expectedJwk: await service.credentialKey(token, "access"),
+      now: service.now(),
+      store: service.store,
+    })
+    const principal = await service.authorize(token, proof.thumbprint)
+    await enabled(principal.identity, options.featurePolicy)
+    service.assertDesktop(identity, principal.binding.target, principal.binding.desktopPublicKey)
+    if (
+      request.bindingId !== principal.binding.bindingId ||
+      deviceAuthorizationTargetKey(request.target) !==
+        deviceAuthorizationTargetKey(principal.binding.target)
+    )
+      throw new DeviceAuthorizationError("target_mismatch", 403)
+    assertDeviceAuthorizationScope(
+      principal,
+      request.method === "GET" ? "relay:read" : "relay:write"
+    )
+    return context.json({
+      protocol: EWDAP_PROTOCOL,
+      binding: principal.binding,
+      grant: service.describeGrant(principal.grant),
+    })
+  })
+  app.get("/bindings", async (context) => {
+    const principal = await authenticateDeviceAuthorizationMobile(context, options)
+    assertDeviceAuthorizationScope(principal, "relay:read")
+    return context.json({ bindings: [principal.binding] })
+  })
+  app.get("/presence", async (context) => {
+    const principal = await authenticateDeviceAuthorizationMobile(context, options)
+    assertDeviceAuthorizationScope(principal, "relay:read")
+    return context.json({
+      onlineDeviceIds:
+        options.presence && (await options.presence.isOnline(principal.binding.desktopDeviceId))
+          ? [principal.binding.desktopDeviceId]
+          : [],
+    })
+  })
+  app.post("/relay/envelopes", async (context) => {
+    const body = await readDeviceAuthorizationBody(context)
+    const principal = await authenticateDeviceAuthorizationMobile(context, options, body)
+    assertDeviceAuthorizationScope(principal, "relay:write")
+    const envelope = encryptedRelayEnvelopeSchema.parse(JSON.parse(body))
+    if (envelope.bindingId !== principal.binding.bindingId)
+      throw new DeviceAuthorizationError("binding_mismatch", 403)
+    await options.relayGuard.acceptAndPublish(principal.identity, envelope, options.relayMailbox)
+    return context.json({ accepted: true }, 202)
+  })
+  app.get("/relay/pending", async (context) => {
+    const principal = await authenticateDeviceAuthorizationMobile(context, options)
+    assertDeviceAuthorizationScope(principal, "relay:read")
+    const envelopes = (await options.relayMailbox.pending(principal.identity.deviceId)).filter(
+      (envelope) =>
+        envelope.bindingId === principal.binding.bindingId &&
+        envelope.recipientDeviceId === principal.identity.deviceId &&
+        envelope.senderDeviceId === principal.binding.desktopDeviceId
+    )
+    return context.json({ envelopes })
+  })
+  app.post("/relay/acknowledgements", async (context) => {
+    const body = await readDeviceAuthorizationBody(context)
+    const principal = await authenticateDeviceAuthorizationMobile(context, options, body)
+    assertDeviceAuthorizationScope(principal, "relay:read")
+    const { envelopes } = z
+      .object({
+        envelopes: z
+          .array(
+            encryptedRelayEnvelopeSchema.pick({
+              bindingId: true,
+              senderDeviceId: true,
+              senderSessionId: true,
+              sequence: true,
+            })
+          )
+          .max(1_000),
+      })
+      .strict()
+      .parse(JSON.parse(body))
+    if (
+      envelopes.some(
+        (envelope) =>
+          envelope.bindingId !== principal.binding.bindingId ||
+          envelope.senderDeviceId !== principal.binding.desktopDeviceId
+      )
+    )
+      throw new DeviceAuthorizationError("binding_mismatch", 403)
+    await options.relayMailbox.acknowledge(principal.identity.deviceId, envelopes)
+    return context.body(null, 204)
+  })
+  app.onError((error, context) => {
+    if (error instanceof DeviceAuthorizationError) {
+      if (error.status === 429) context.header("Retry-After", "60")
+      return new Response(JSON.stringify({ error: { code: error.code, message: error.code } }), {
+        status: error.status,
+        headers: {
+          "Content-Type": "application/json",
+          "Cache-Control": "no-store",
+          ...(error.status === 429 ? { "Retry-After": "60" } : {}),
+        },
+      })
+    }
+    if (error instanceof z.ZodError || error instanceof SyntaxError)
+      return context.json({ error: { code: "invalid_request", message: "invalid_request" } }, 400)
+    return context.json({ error: { code: "unavailable", message: "unavailable" } }, 503)
+  })
+  return app
+}
diff --git a/apps/remote-access-service/src/device-authorization/records.ts b/apps/remote-access-service/src/device-authorization/records.ts
new file mode 100644
index 0000000..d2b42a0
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/records.ts
@@ -0,0 +1,84 @@
+import {
+  deviceAuthorizationDeviceSchema,
+  deviceGrantDescriptionSchema,
+  deviceOfferViewSchema,
+  remoteBindingSchema,
+} from "@easyai-desktop/remote-access"
+import { z } from "zod"
+
+export const storedOfferSchema = deviceOfferViewSchema
+  .extend({ codeDigest: z.string(), sealedDescriptor: z.string(), claimId: z.string().optional() })
+  .strict()
+export const storedClaimSchema = z
+  .object({
+    claimId: z.string(),
+    offerId: z.string(),
+    device: deviceAuthorizationDeviceSchema,
+    authKeyThumbprint: z.string(),
+    transcriptHash: z.string(),
+    verificationCode: z.string(),
+    status: z.enum(["pending", "approved", "rejected", "expired", "revoked"]),
+    expiresAt: z.string().datetime(),
+    pendingDelivery: z.string(),
+    grantDelivery: z.string().optional(),
+    grantId: z.string().optional(),
+  })
+  .strict()
+export const storedGrantSchema = deviceGrantDescriptionSchema
+  .extend({
+    device: deviceAuthorizationDeviceSchema,
+    absoluteExpiresAt: z.string().datetime(),
+    accessExpiresAt: z.string().datetime(),
+    refreshVersion: z.number().int().positive(),
+    desktopPublicKey: z.string(),
+    claimId: z.string(),
+    offerId: z.string(),
+  })
+  .strict()
+export const storedCredentialSchema = z
+  .object({
+    kind: z.enum(["pending", "access", "refresh"]),
+    ownerId: z.string(),
+    expiresAt: z.string().datetime(),
+    version: z.number().int().positive(),
+    consumedBy: z.string().optional(),
+  })
+  .strict()
+export const storedOperationSchema = z
+  .object({ intentHash: z.string(), result: z.unknown() })
+  .strict()
+export const claimResponseSchema = z
+  .object({
+    protocol: z.literal("EWDAP/1"),
+    claimId: z.string(),
+    offerId: z.string(),
+    status: storedClaimSchema.shape.status,
+    expiresAt: z.string().datetime(),
+    sealedDelivery: z.string().optional(),
+    transcriptHash: z.string().optional(),
+    verificationCode: z.string().optional(),
+  })
+  .strict()
+export const decisionResponseSchema = z
+  .object({
+    protocol: z.literal("EWDAP/1"),
+    claimId: z.string(),
+    status: z.enum(["approved", "rejected"]),
+    binding: remoteBindingSchema.optional(),
+    grant: deviceGrantDescriptionSchema.optional(),
+  })
+  .strict()
+export const refreshResponseSchema = z
+  .object({ protocol: z.literal("EWDAP/1"), grantId: z.string(), sealedDelivery: z.string() })
+  .strict()
+export const revocationResponseSchema = z
+  .object({
+    protocol: z.literal("EWDAP/1"),
+    grantId: z.string(),
+    status: z.literal("revoked"),
+    bindingId: z.string(),
+  })
+  .strict()
+export type StoredDeviceOffer = z.infer<typeof storedOfferSchema>
+export type StoredDeviceClaim = z.infer<typeof storedClaimSchema>
+export type StoredDeviceGrant = z.infer<typeof storedGrantSchema>
diff --git a/apps/remote-access-service/src/device-authorization/repository.ts b/apps/remote-access-service/src/device-authorization/repository.ts
new file mode 100644
index 0000000..c346feb
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/repository.ts
@@ -0,0 +1,63 @@
+import {
+  remoteBindingSchema,
+  type RemoteAccessRepository,
+  type RemoteBinding,
+} from "@easyai-desktop/remote-access"
+
+import { storedGrantSchema } from "./records.js"
+import type { DeviceAuthorizationStore } from "./store.js"
+
+/** One authoritative EWDAP binding; no non-atomic mirror into the legacy store. */
+export function withDeviceAuthorizationBindings(
+  legacy: RemoteAccessRepository,
+  store: DeviceAuthorizationStore
+): RemoteAccessRepository {
+  const findBinding = async (bindingId: string) => {
+    const binding = await store.transaction([], async (transaction) =>
+      transaction.get("bindings", bindingId)
+    )
+    return binding ? remoteBindingSchema.parse(binding) : await legacy.findBinding(bindingId)
+  }
+  return {
+    ...legacy,
+    findBinding,
+    async listBindingsForDevice(deviceId) {
+      const [old, current] = await Promise.all([
+        legacy.listBindingsForDevice(deviceId),
+        store.transaction([], async (transaction) =>
+          (await transaction.list("bindings"))
+            .map((binding) => remoteBindingSchema.parse(binding))
+            .filter(
+              (binding) =>
+                binding.desktopDeviceId === deviceId || binding.mobileDeviceId === deviceId
+            )
+        ),
+      ])
+      return [...old, ...current]
+    },
+    async saveBinding(binding: RemoteBinding) {
+      if (!binding.deviceAuthorization) return await legacy.saveBinding(binding)
+      await store.transaction(
+        [`grant:${binding.deviceAuthorization.grantId}`],
+        async (transaction) => {
+          const previous = remoteBindingSchema.parse(
+            await transaction.get("bindings", binding.bindingId)
+          )
+          if (
+            previous.desktopPublicKey !== binding.desktopPublicKey ||
+            previous.mobilePublicKey !== binding.mobilePublicKey
+          )
+            throw new Error("EWDAP key changes require desktop re-pairing")
+          const grant = storedGrantSchema.parse(
+            await transaction.get("grants", binding.deviceAuthorization!.grantId)
+          )
+          if (grant.status === "revoked" && binding.status === "active")
+            throw new Error("revoked EWDAP binding cannot reactivate")
+          await transaction.put("bindings", binding.bindingId, binding)
+          if (binding.status === "revoked")
+            await transaction.put("grants", grant.grantId, { ...grant, status: "revoked" })
+        }
+      )
+    },
+  }
+}
diff --git a/apps/remote-access-service/src/device-authorization/service.ts b/apps/remote-access-service/src/device-authorization/service.ts
new file mode 100644
index 0000000..5703acf
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/service.ts
@@ -0,0 +1,683 @@
+import { randomBytes, randomUUID } from "node:crypto"
+
+import {
+  deviceAuthorizationTargetKey,
+  deviceAuthorizationScopes,
+  deviceGrantDescriptionSchema,
+  deviceOfferViewSchema,
+  EWDAP_PROTOCOL,
+  remoteBindingSchema,
+  sealDeviceAuthorizationDelivery,
+  type RemoteBinding,
+  type RemoteDeviceIdentity,
+  type DeviceClaimRequest,
+} from "@easyai-desktop/remote-access"
+import { calculateJwkThumbprint } from "jose"
+import { z } from "zod"
+
+import {
+  DeviceAuthorizationError,
+  deviceAuthorizationIntent,
+  deviceAuthorizationToken,
+  digestDeviceAuthorizationToken,
+  equalAuthorizationValue,
+  hashDeviceAuthorizationValue,
+} from "./crypto.js"
+import {
+  claimResponseSchema,
+  decisionResponseSchema,
+  refreshResponseSchema,
+  revocationResponseSchema,
+  storedClaimSchema,
+  storedCredentialSchema,
+  storedGrantSchema,
+  storedOfferSchema,
+  storedOperationSchema,
+  type StoredDeviceGrant,
+} from "./records.js"
+import type { DeviceAuthorizationStore, DeviceAuthorizationTransaction } from "./store.js"
+
+const minutes = 60_000,
+  days = 24 * 60 * minutes
+export type DeviceAuthorizationServiceOptions = {
+  store: DeviceAuthorizationStore
+  pepper: Uint8Array
+  relayOrigin: string
+  now?: () => Date
+  offerLifetimeMs?: number
+  accessLifetimeMs?: number
+  refreshLifetimeMs?: number
+}
+export type AuthorizedMobileDevice = {
+  identity: RemoteDeviceIdentity
+  binding: RemoteBinding
+  grant: StoredDeviceGrant
+}
+export class DeviceAuthorizationService {
+  readonly store: DeviceAuthorizationStore
+  readonly now: () => Date
+  readonly #pepper: Uint8Array
+  readonly #relayOrigin: string
+  readonly #offerLifetime: number
+  readonly #accessLifetime: number
+  readonly #refreshLifetime: number
+  constructor(options: DeviceAuthorizationServiceOptions) {
+    if (options.pepper.length < 32) throw new Error("EWDAP pepper requires 32 bytes")
+    this.store = options.store
+    this.#pepper = options.pepper.slice()
+    this.#relayOrigin = new URL(options.relayOrigin).origin
+    this.now = options.now ?? (() => new Date())
+    this.#offerLifetime = options.offerLifetimeMs ?? 5 * minutes
+    this.#accessLifetime = options.accessLifetimeMs ?? 10 * minutes
+    this.#refreshLifetime = options.refreshLifetimeMs ?? 30 * days
+  }
+  digest(token: string) {
+    return digestDeviceAuthorizationToken(this.#pepper, token)
+  }
+  expires(duration: number) {
+    return new Date(this.now().getTime() + duration).toISOString()
+  }
+  isExpired(value: string) {
+    return Date.parse(value) <= this.now().getTime()
+  }
+  async rateLimit(key: string, limit: number, durationMs: number) {
+    await this.store.transaction([`rate:${key}`], async (transaction) => {
+      const schema = z.object({ count: z.number(), expiresAt: z.string() })
+      const stored = await transaction.get("limits", key)
+      const current = stored ? schema.parse(stored) : undefined
+      const next =
+        !current || this.isExpired(current.expiresAt)
+          ? { count: 1, expiresAt: this.expires(durationMs) }
+          : { ...current, count: current.count + 1 }
+      if (next.count > limit) throw new DeviceAuthorizationError("rate_limited", 429)
+      await transaction.put("limits", key, next)
+    })
+  }
+  async #operation<T>(
+    transaction: DeviceAuthorizationTransaction,
+    key: string,
+    intent: unknown,
+    schema: z.ZodType<T>
+  ): Promise<T | undefined> {
+    const raw = await transaction.get("operations", key)
+    if (!raw) return undefined
+    const operation = storedOperationSchema.parse(raw)
+    if (!equalAuthorizationValue(operation.intentHash, deviceAuthorizationIntent(intent)))
+      throw new DeviceAuthorizationError("operation_conflict", 409)
+    return schema.parse(operation.result)
+  }
+  async #saveOperation(
+    transaction: DeviceAuthorizationTransaction,
+    key: string,
+    intent: unknown,
+    result: unknown
+  ) {
+    await transaction.put("operations", key, {
+      intentHash: deviceAuthorizationIntent(intent),
+      result,
+    })
+  }
+  async createOffer(
+    desktop: RemoteDeviceIdentity,
+    request: { operationId: string; target: RemoteBinding["target"] }
+  ) {
+    this.assertDesktop(desktop, request.target)
+    const operationKey = `offer:${desktop.account.authority}:${desktop.account.subject}:${desktop.deviceId}:${request.operationId}`
+    const result = await this.store.transaction([operationKey], async (transaction) => {
+      const existing = await this.#operation(
+        transaction,
+        operationKey,
+        request,
+        deviceOfferViewSchema
+      )
+      if (existing) return existing
+      const offerId = randomUUID()
+      const alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+      let connectionCode = "",
+        codeDigest = ""
+      for (let attempt = 0; attempt < 10; attempt++) {
+        connectionCode = [...randomBytes(16)].map((value) => alphabet[value & 31]).join("")
+        codeDigest = this.digest(connectionCode)
+        if (await transaction.insert("codes", codeDigest, { offerId })) break
+        if (attempt === 9) throw new DeviceAuthorizationError("offer_unavailable", 503)
+      }
+      const expiresAt = this.expires(this.#offerLifetime)
+      const sealedDescriptor = await sealDeviceAuthorizationDelivery(desktop.publicKey, offerId, {
+        protocol: EWDAP_PROTOCOL,
+        deliveryId: offerId,
+        offerId,
+        connectionCode,
+        expiresAt,
+        relayOrigin: this.#relayOrigin,
+        desktopPublicKey: desktop.publicKey,
+        target: request.target,
+      })
+      const offer = storedOfferSchema.parse({
+        protocol: EWDAP_PROTOCOL,
+        offerId,
+        target: request.target,
+        desktop,
+        expiresAt,
+        status: "offered",
+        sealedDescriptor,
+        codeDigest,
+      })
+      await transaction.put("offers", offerId, offer)
+      const view = this.offerView(offer)
+      await this.#saveOperation(transaction, operationKey, request, view)
+      return view
+    })
+    return result
+  }
+  assertDesktop(
+    desktop: RemoteDeviceIdentity,
+    target: RemoteBinding["target"],
+    publicKey?: string
+  ) {
+    if (
+      desktop.platform !== "desktop" ||
+      desktop.deviceId !== target.desktopDeviceId ||
+      desktop.account.authority !== target.account.authority ||
+      desktop.account.subject !== target.account.subject ||
+      (publicKey && desktop.publicKey !== publicKey)
+    )
+      throw new DeviceAuthorizationError("desktop_target_mismatch", 403)
+  }
+  offerView(offer: z.infer<typeof storedOfferSchema>) {
+    const { codeDigest: _codeDigest, claimId: _claimId, ...view } = offer
+    return deviceOfferViewSchema.parse(view)
+  }
+  async claim(request: DeviceClaimRequest, thumbprint: string) {
+    const operationKey = `claim:${thumbprint}:${request.operationId}`
+    const digest = this.digest(request.connectionCode)
+    const mapped = await this.store.transaction([], async (tx) => tx.get("codes", digest))
+    const offerId = mapped ? z.object({ offerId: z.string() }).parse(mapped).offerId : undefined
+    return await this.store.transaction(
+      [operationKey, `offer:${offerId ?? digest}`],
+      async (transaction) => {
+        const existing = await this.#operation(
+          transaction,
+          operationKey,
+          request,
+          claimResponseSchema
+        )
+        if (existing) return existing
+        if (!offerId) throw new DeviceAuthorizationError("offer_not_found", 404)
+        const offer = storedOfferSchema.parse(await transaction.get("offers", offerId))
+        if (this.isExpired(offer.expiresAt))
+          throw new DeviceAuthorizationError("offer_expired", 410)
+        if (offer.status !== "offered") throw new DeviceAuthorizationError("offer_unavailable", 409)
+        if (thumbprint !== (await calculateJwkThumbprint(request.device.authPublicKey)))
+          throw new DeviceAuthorizationError("invalid_dpop")
+        const claimId = randomUUID(),
+          pendingToken = deviceAuthorizationToken()
+        const transcriptHash = deviceAuthorizationIntent({
+          offerId,
+          target: offer.target,
+          desktopPublicKey: offer.desktop.publicKey,
+          device: request.device,
+          operationId: request.operationId,
+        })
+        const verificationCode = hashDeviceAuthorizationValue(transcriptHash)
+          .slice(0, 8)
+          .toUpperCase()
+        const pendingExpiry = new Date(Date.parse(offer.expiresAt) + 10 * minutes).toISOString()
+        const pendingDelivery = await sealDeviceAuthorizationDelivery(
+          request.device.publicKey,
+          claimId,
+          {
+            protocol: EWDAP_PROTOCOL,
+            deliveryId: claimId,
+            claimId,
+            pendingToken,
+            expiresAt: pendingExpiry,
+          }
+        )
+        const claim = storedClaimSchema.parse({
+          claimId,
+          offerId,
+          device: request.device,
+          authKeyThumbprint: thumbprint,
+          transcriptHash,
+          verificationCode,
+          status: "pending",
+          expiresAt: offer.expiresAt,
+          pendingDelivery,
+        })
+        await transaction.put("claims", claimId, claim)
+        await transaction.put("credentials", this.digest(pendingToken), {
+          kind: "pending",
+          ownerId: claimId,
+          expiresAt: pendingExpiry,
+          version: 1,
+        })
+        await transaction.put("offers", offerId, {
+          ...offer,
+          claimId,
+          status: "pending",
+          claim: { claimId, device: request.device, transcriptHash, verificationCode },
+        })
+        const response = claimResponseSchema.parse({
+          protocol: EWDAP_PROTOCOL,
+          claimId,
+          offerId,
+          status: "pending",
+          expiresAt: claim.expiresAt,
+          transcriptHash,
+          verificationCode,
+          sealedDelivery: pendingDelivery,
+        })
+        await this.#saveOperation(transaction, operationKey, request, response)
+        return response
+      }
+    )
+  }
+  async getOffer(offerId: string, desktop: RemoteDeviceIdentity) {
+    return await this.store.transaction([`offer:${offerId}`], async (transaction) => {
+      const raw = await transaction.get("offers", offerId)
+      if (!raw) throw new DeviceAuthorizationError("offer_not_found", 404)
+      const offer = storedOfferSchema.parse(raw)
+      this.assertDesktop(desktop, offer.target, offer.desktop.publicKey)
+      if (offer.claimId && offer.status === "approved") {
+        const claim = storedClaimSchema.parse(await transaction.get("claims", offer.claimId))
+        if (claim.grantId) {
+          const grant = storedGrantSchema.parse(await transaction.get("grants", claim.grantId))
+          if (grant.status === "revoked") return this.offerView({ ...offer, status: "revoked" })
+        }
+      }
+      return this.offerView(
+        this.isExpired(offer.expiresAt) && ["offered", "pending"].includes(offer.status)
+          ? { ...offer, status: "expired" }
+          : offer
+      )
+    })
+  }
+  async decide(
+    claimId: string,
+    desktop: RemoteDeviceIdentity,
+    request: { operationId: string; decision: "approve" | "reject"; transcriptHash: string }
+  ) {
+    const first = await this.store.transaction([], async (transaction) =>
+      transaction.get("claims", claimId)
+    )
+    if (!first) throw new DeviceAuthorizationError("claim_not_found", 404)
+    const claimOfferId = storedClaimSchema.parse(first).offerId
+    const operationKey = `decision:${desktop.account.authority}:${desktop.account.subject}:${desktop.deviceId}:${request.operationId}`
+    return await this.store.transaction(
+      [operationKey, `offer:${claimOfferId}`],
+      async (transaction) => {
+        const offer = storedOfferSchema.parse(await transaction.get("offers", claimOfferId))
+        this.assertDesktop(desktop, offer.target, offer.desktop.publicKey)
+        const intent = { claimId, ...request }
+        const existing = await this.#operation(
+          transaction,
+          operationKey,
+          intent,
+          decisionResponseSchema
+        )
+        if (existing) return existing
+        const claim = storedClaimSchema.parse(await transaction.get("claims", claimId))
+        if (claim.transcriptHash !== request.transcriptHash)
+          throw new DeviceAuthorizationError("claim_changed", 409)
+        if (claim.status !== "pending" || offer.status !== "pending")
+          throw new DeviceAuthorizationError("claim_unavailable", 409)
+        if (this.isExpired(offer.expiresAt))
+          throw new DeviceAuthorizationError("offer_expired", 410)
+        let response: z.infer<typeof decisionResponseSchema>
+        if (request.decision === "reject") {
+          await transaction.put("claims", claimId, { ...claim, status: "rejected" })
+          await transaction.put("offers", offer.offerId, { ...offer, status: "rejected" })
+          response = { protocol: EWDAP_PROTOCOL, claimId, status: "rejected" }
+        } else {
+          const grantId = randomUUID(),
+            bindingId = randomUUID()
+          const grant = storedGrantSchema.parse({
+            protocol: EWDAP_PROTOCOL,
+            grantId,
+            bindingId,
+            deviceId: claim.device.deviceId,
+            device: claim.device,
+            target: offer.target,
+            keyVersion: 1,
+            authKeyThumbprint: claim.authKeyThumbprint,
+            scopes: [...deviceAuthorizationScopes],
+            status: "active",
+            desktopPublicKey: desktop.publicKey,
+            claimId,
+            offerId: offer.offerId,
+            expiresAt: this.expires(this.#refreshLifetime),
+            absoluteExpiresAt: this.expires(90 * days),
+            accessExpiresAt: this.expires(this.#accessLifetime),
+            refreshVersion: 1,
+          })
+          const binding = remoteBindingSchema.parse({
+            bindingId,
+            account: offer.desktop.account,
+            target: offer.target,
+            desktopDeviceId: desktop.deviceId,
+            mobileDeviceId: claim.device.deviceId,
+            desktopPublicKey: desktop.publicKey,
+            mobilePublicKey: claim.device.publicKey,
+            status: "active",
+            createdAt: this.now().toISOString(),
+            confirmedAt: this.now().toISOString(),
+            deviceAuthorization: {
+              protocol: EWDAP_PROTOCOL,
+              grantId,
+              keyVersion: 1,
+              authKeyThumbprint: claim.authKeyThumbprint,
+            },
+          })
+          await transaction.put("bindings", bindingId, binding)
+          await transaction.put("grants", grantId, grant)
+          const sealedDelivery = await this.#issueTokens(transaction, grant, binding, claimId)
+          await transaction.put("claims", claimId, {
+            ...claim,
+            status: "approved",
+            grantId,
+            grantDelivery: sealedDelivery,
+          })
+          await transaction.put("offers", offer.offerId, { ...offer, status: "approved" })
+          response = {
+            protocol: EWDAP_PROTOCOL,
+            claimId,
+            status: "approved",
+            binding,
+            grant: this.describeGrant(grant),
+          }
+        }
+        await this.#saveOperation(transaction, operationKey, intent, response)
+        return response
+      }
+    )
+  }
+  describeGrant(grant: StoredDeviceGrant) {
+    const {
+      claimId: _claimId,
+      offerId: _offerId,
+      desktopPublicKey: _desktopKey,
+      device: _device,
+      absoluteExpiresAt: _absolute,
+      accessExpiresAt: _access,
+      refreshVersion: _version,
+      ...description
+    } = grant
+    return deviceGrantDescriptionSchema.parse(description)
+  }
+  async #issueTokens(
+    transaction: DeviceAuthorizationTransaction,
+    grant: StoredDeviceGrant,
+    binding: RemoteBinding,
+    deliveryId: string
+  ) {
+    const accessToken = deviceAuthorizationToken(),
+      refreshToken = deviceAuthorizationToken()
+    await transaction.put("credentials", this.digest(accessToken), {
+      kind: "access",
+      ownerId: grant.grantId,
+      version: grant.refreshVersion,
+      expiresAt: grant.accessExpiresAt,
+    })
+    await transaction.put("credentials", this.digest(refreshToken), {
+      kind: "refresh",
+      ownerId: grant.grantId,
+      version: grant.refreshVersion,
+      expiresAt: grant.expiresAt,
+    })
+    return await sealDeviceAuthorizationDelivery(grant.device.publicKey, deliveryId, {
+      protocol: EWDAP_PROTOCOL,
+      deliveryId,
+      grantId: grant.grantId,
+      deviceId: grant.deviceId,
+      binding,
+      target: grant.target,
+      keyVersion: grant.keyVersion,
+      scopes: grant.scopes,
+      accessToken,
+      accessExpiresAt: grant.accessExpiresAt,
+      refreshToken,
+      refreshExpiresAt: grant.expiresAt,
+    })
+  }
+  async refresh(token: string, thumbprint: string, operationId: string) {
+    const digest = this.digest(token)
+    const raw = await this.store.transaction([], async (tx) => tx.get("credentials", digest))
+    if (!raw) throw new DeviceAuthorizationError("unauthorized")
+    const credential = storedCredentialSchema.parse(raw)
+    if (credential.kind !== "refresh") throw new DeviceAuthorizationError("unauthorized")
+    const operationKey = `refresh:${credential.ownerId}:${operationId}`
+    return await this.store.transaction(
+      [`grant:${credential.ownerId}`, operationKey],
+      async (transaction) => {
+        const current = storedCredentialSchema.parse(await transaction.get("credentials", digest))
+        const grant = storedGrantSchema.parse(await transaction.get("grants", current.ownerId))
+        const binding = await this.requireActiveBinding(transaction, grant, thumbprint)
+        if (this.isExpired(current.expiresAt)) throw new DeviceAuthorizationError("refresh_expired")
+        const intent = { digest, operationId }
+        const existing = await this.#operation(
+          transaction,
+          operationKey,
+          intent,
+          refreshResponseSchema
+        )
+        if (existing) return existing
+        if (current.consumedBy || current.version !== grant.refreshVersion)
+          throw new DeviceAuthorizationError("refresh_reused", 409)
+        const next = {
+          ...grant,
+          refreshVersion: grant.refreshVersion + 1,
+          accessExpiresAt: this.expires(this.#accessLifetime),
+          expiresAt: new Date(
+            Math.min(
+              Date.parse(grant.absoluteExpiresAt),
+              this.now().getTime() + this.#refreshLifetime
+            )
+          ).toISOString(),
+        }
+        const sealedDelivery = await this.#issueTokens(transaction, next, binding, operationId)
+        await transaction.put("credentials", digest, { ...current, consumedBy: operationId })
+        await transaction.put("grants", grant.grantId, next)
+        const result = { protocol: EWDAP_PROTOCOL, grantId: grant.grantId, sealedDelivery }
+        await this.#saveOperation(transaction, operationKey, intent, result)
+        return result
+      }
+    )
+  }
+  async requireActiveBinding(
+    transaction: DeviceAuthorizationTransaction,
+    grant: StoredDeviceGrant,
+    thumbprint: string
+  ) {
+    if (
+      grant.status !== "active" ||
+      this.isExpired(grant.expiresAt) ||
+      this.isExpired(grant.absoluteExpiresAt)
+    )
+      throw new DeviceAuthorizationError("grant_inactive", 403)
+    if (!equalAuthorizationValue(thumbprint, grant.authKeyThumbprint))
+      throw new DeviceAuthorizationError("device_key_mismatch", 403)
+    const raw = await transaction.get("bindings", grant.bindingId)
+    const binding = raw ? remoteBindingSchema.parse(raw) : undefined
+    if (
+      !binding ||
+      binding.status !== "active" ||
+      binding.deviceAuthorization?.grantId !== grant.grantId ||
+      binding.deviceAuthorization.keyVersion !== grant.keyVersion ||
+      binding.deviceAuthorization.authKeyThumbprint !== thumbprint ||
+      binding.desktopPublicKey !== grant.desktopPublicKey ||
+      binding.desktopDeviceId !== grant.target.desktopDeviceId ||
+      binding.account.authority !== grant.target.account.authority ||
+      binding.account.subject !== grant.target.account.subject ||
+      binding.mobilePublicKey !== grant.device.publicKey ||
+      binding.mobileDeviceId !== grant.deviceId ||
+      deviceAuthorizationTargetKey(binding.target) !== deviceAuthorizationTargetKey(grant.target)
+    )
+      throw new DeviceAuthorizationError("binding_inactive", 403)
+    return binding
+  }
+  async credentialKey(token: string, kind: "pending" | "access" | "refresh") {
+    return await this.store.transaction([], async (transaction) => {
+      const raw = await transaction.get("credentials", this.digest(token))
+      const credential = raw ? storedCredentialSchema.parse(raw) : undefined
+      if (!credential || credential.kind !== kind)
+        throw new DeviceAuthorizationError("unauthorized")
+      const owner =
+        kind === "pending"
+          ? storedClaimSchema.parse(await transaction.get("claims", credential.ownerId))
+          : storedGrantSchema.parse(await transaction.get("grants", credential.ownerId))
+      return owner.device.authPublicKey
+    })
+  }
+  async authorize(token: string, thumbprint: string): Promise<AuthorizedMobileDevice> {
+    return await this.store.transaction([], async (transaction) => {
+      const raw = await transaction.get("credentials", this.digest(token))
+      const credential = raw ? storedCredentialSchema.parse(raw) : undefined
+      if (!credential || credential.kind !== "access" || this.isExpired(credential.expiresAt))
+        throw new DeviceAuthorizationError("unauthorized")
+      const grant = storedGrantSchema.parse(await transaction.get("grants", credential.ownerId))
+      if (credential.version !== grant.refreshVersion)
+        throw new DeviceAuthorizationError("credential_rotated")
+      const binding = await this.requireActiveBinding(transaction, grant, thumbprint)
+      return {
+        binding,
+        grant,
+        identity: {
+          account: grant.target.account,
+          deviceId: grant.deviceId,
+          platform: grant.device.platform,
+          publicKey: grant.device.publicKey,
+          integrity: "unknown",
+        },
+      }
+    })
+  }
+  async refreshIdentity(token: string, thumbprint: string): Promise<RemoteDeviceIdentity> {
+    return await this.store.transaction([], async (transaction) => {
+      const credential = storedCredentialSchema.parse(
+        await transaction.get("credentials", this.digest(token))
+      )
+      if (credential.kind !== "refresh" || this.isExpired(credential.expiresAt))
+        throw new DeviceAuthorizationError("unauthorized")
+      const grant = storedGrantSchema.parse(await transaction.get("grants", credential.ownerId))
+      await this.requireActiveBinding(transaction, grant, thumbprint)
+      return {
+        account: grant.target.account,
+        deviceId: grant.deviceId,
+        platform: grant.device.platform,
+        publicKey: grant.device.publicKey,
+        integrity: "unknown",
+      }
+    })
+  }
+  async authorizeRevocation(
+    token: string,
+    thumbprint: string,
+    grantId: string
+  ): Promise<AuthorizedMobileDevice> {
+    return await this.store.transaction([], async (transaction) => {
+      const raw = await transaction.get("credentials", this.digest(token))
+      const credential = raw ? storedCredentialSchema.parse(raw) : undefined
+      if (!credential || credential.kind !== "access" || this.isExpired(credential.expiresAt))
+        throw new DeviceAuthorizationError("unauthorized")
+      if (credential.ownerId !== grantId) throw new DeviceAuthorizationError("grant_mismatch", 403)
+      const grant = storedGrantSchema.parse(await transaction.get("grants", grantId))
+      if (grant.authKeyThumbprint !== thumbprint || credential.version !== grant.refreshVersion)
+        throw new DeviceAuthorizationError("device_key_mismatch", 403)
+      const binding = remoteBindingSchema.parse(await transaction.get("bindings", grant.bindingId))
+      return {
+        grant,
+        binding,
+        identity: {
+          account: grant.target.account,
+          deviceId: grant.deviceId,
+          platform: grant.device.platform,
+          publicKey: grant.device.publicKey,
+          integrity: "unknown",
+        },
+      }
+    })
+  }
+  async getClaim(claimId: string, token: string, thumbprint: string) {
+    return await this.store.transaction([], async (transaction) => {
+      const raw = await transaction.get("credentials", this.digest(token))
+      const credential = raw ? storedCredentialSchema.parse(raw) : undefined
+      if (
+        !credential ||
+        credential.kind !== "pending" ||
+        credential.ownerId !== claimId ||
+        this.isExpired(credential.expiresAt)
+      )
+        throw new DeviceAuthorizationError("unauthorized")
+      const claim = storedClaimSchema.parse(await transaction.get("claims", claimId))
+      if (claim.authKeyThumbprint !== thumbprint)
+        throw new DeviceAuthorizationError("device_key_mismatch", 403)
+      let status = claim.status
+      if (status === "pending" && this.isExpired(claim.expiresAt)) status = "expired"
+      if (status === "approved") {
+        const grant = storedGrantSchema.parse(await transaction.get("grants", claim.grantId!))
+        if (grant.status !== "active") status = "revoked"
+      }
+      return claimResponseSchema.parse({
+        protocol: EWDAP_PROTOCOL,
+        claimId,
+        offerId: claim.offerId,
+        status,
+        expiresAt: claim.expiresAt,
+        transcriptHash: claim.transcriptHash,
+        verificationCode: claim.verificationCode,
+        ...(status === "approved" ? { sealedDelivery: claim.grantDelivery } : {}),
+      })
+    })
+  }
+  async bindingAuthorization(bindingId: string, desktop: RemoteDeviceIdentity) {
+    return await this.store.transaction([], async (transaction) => {
+      const raw = await transaction.get("bindings", bindingId)
+      if (!raw) throw new DeviceAuthorizationError("binding_not_found", 404)
+      const binding = remoteBindingSchema.parse(raw)
+      this.assertDesktop(desktop, binding.target, binding.desktopPublicKey)
+      const grant = storedGrantSchema.parse(
+        await transaction.get("grants", binding.deviceAuthorization!.grantId)
+      )
+      return { protocol: EWDAP_PROTOCOL, binding, grant: this.describeGrant(grant) }
+    })
+  }
+  async revoke(
+    grantId: string,
+    operationId: string,
+    principal: RemoteDeviceIdentity | AuthorizedMobileDevice
+  ) {
+    const operationKey = `revoke:${grantId}:${operationId}`
+    return await this.store.transaction([`grant:${grantId}`, operationKey], async (transaction) => {
+      const raw = await transaction.get("grants", grantId)
+      if (!raw) throw new DeviceAuthorizationError("grant_not_found", 404)
+      const grant = storedGrantSchema.parse(raw)
+      const binding = remoteBindingSchema.parse(await transaction.get("bindings", grant.bindingId))
+      if ("identity" in principal) {
+        if (principal.grant.grantId !== grantId)
+          throw new DeviceAuthorizationError("grant_mismatch", 403)
+      } else this.assertDesktop(principal, binding.target, binding.desktopPublicKey)
+      const intent = { grantId, operationId }
+      const existing = await this.#operation(
+        transaction,
+        operationKey,
+        intent,
+        revocationResponseSchema
+      )
+      if (existing) return existing
+      await transaction.put("grants", grantId, { ...grant, status: "revoked" })
+      await transaction.put("bindings", binding.bindingId, { ...binding, status: "revoked" })
+      const claim = storedClaimSchema.parse(await transaction.get("claims", grant.claimId))
+      const offer = storedOfferSchema.parse(await transaction.get("offers", grant.offerId))
+      await transaction.put("claims", claim.claimId, { ...claim, status: "revoked" })
+      await transaction.put("offers", offer.offerId, { ...offer, status: "revoked" })
+      const result = {
+        protocol: EWDAP_PROTOCOL,
+        grantId,
+        bindingId: binding.bindingId,
+        status: "revoked" as const,
+      }
+      await this.#saveOperation(transaction, operationKey, intent, result)
+      return result
+    })
+  }
+}
diff --git a/apps/remote-access-service/src/device-authorization/store.ts b/apps/remote-access-service/src/device-authorization/store.ts
new file mode 100644
index 0000000..fb57a3e
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/store.ts
@@ -0,0 +1,205 @@
+import { randomUUID } from "node:crypto"
+import { mkdir, open, readFile, rename, rm, lstat, writeFile } from "node:fs/promises"
+import path from "node:path"
+
+import postgres from "postgres"
+import { z } from "zod"
+
+export type DeviceAuthorizationRecordKind =
+  | "offers"
+  | "claims"
+  | "grants"
+  | "credentials"
+  | "operations"
+  | "proofs"
+  | "bindings"
+  | "codes"
+  | "limits"
+export type DeviceAuthorizationTransaction = {
+  get(kind: DeviceAuthorizationRecordKind, id: string): Promise<unknown | undefined>
+  list(kind: DeviceAuthorizationRecordKind): Promise<readonly unknown[]>
+  put(kind: DeviceAuthorizationRecordKind, id: string, value: unknown): Promise<void>
+  insert(kind: DeviceAuthorizationRecordKind, id: string, value: unknown): Promise<boolean>
+  remove(kind: DeviceAuthorizationRecordKind, id: string): Promise<void>
+}
+export type DeviceAuthorizationStore = {
+  transaction<T>(
+    locks: readonly string[],
+    operation: (transaction: DeviceAuthorizationTransaction) => Promise<T>
+  ): Promise<T>
+  close(): Promise<void>
+}
+const diskSchema = z
+  .object({ version: z.literal(1), records: z.record(z.string(), z.unknown()) })
+  .strict()
+const queues = new Map<string, Promise<void>>()
+const recordKey = (kind: string, id: string) => JSON.stringify([kind, id])
+const delay = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms))
+
+async function readDisk(statePath: string) {
+  try {
+    if (!(await lstat(statePath)).isFile()) throw new Error("EWDAP state must be a regular file")
+    return diskSchema.parse(JSON.parse(await readFile(statePath, "utf8")))
+  } catch (error) {
+    if (error instanceof Error && "code" in error && error.code === "ENOENT")
+      return { version: 1 as const, records: {} as Record<string, unknown> }
+    throw error
+  }
+}
+async function persist(statePath: string, state: z.infer<typeof diskSchema>) {
+  const temporary = `${statePath}.${randomUUID()}.tmp`
+  const file = await open(temporary, "wx", 0o600)
+  try {
+    await file.writeFile(JSON.stringify(state))
+    await file.sync()
+  } finally {
+    await file.close()
+  }
+  try {
+    await rename(temporary, statePath)
+  } finally {
+    await rm(temporary, { force: true })
+  }
+  const directory = await open(path.dirname(statePath), "r")
+  try {
+    await directory.sync()
+  } finally {
+    await directory.close()
+  }
+}
+async function lockFile(statePath: string): Promise<() => Promise<void>> {
+  const lock = `${statePath}.lock`
+  for (let attempt = 0; attempt < 100; attempt++) {
+    try {
+      await mkdir(lock, { mode: 0o700 })
+      await writeFile(path.join(lock, "owner"), String(process.pid), { mode: 0o600 })
+      return async () => {
+        await rm(lock, { recursive: true, force: true })
+      }
+    } catch (error) {
+      if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw error
+      try {
+        const pid = Number(await readFile(path.join(lock, "owner"), "utf8"))
+        if (Number.isSafeInteger(pid) && pid > 0) {
+          try {
+            process.kill(pid, 0)
+          } catch (failure) {
+            if (failure instanceof Error && "code" in failure && failure.code === "ESRCH") {
+              await rm(lock, { recursive: true, force: true })
+              continue
+            }
+          }
+        }
+      } catch {
+        /* A lock whose owner has not been published yet is not safe to remove. */
+      }
+      await delay(10)
+    }
+  }
+  throw new Error("EWDAP persistence is busy")
+}
+
+/** File-backed transactions, with atomic publication and an inter-process owner lock. */
+export function createLocalDeviceAuthorizationStore(statePath: string): DeviceAuthorizationStore {
+  return {
+    async transaction(_locks, operation) {
+      const previous = queues.get(statePath) ?? Promise.resolve()
+      const current = previous
+        .catch(() => undefined)
+        .then(async () => {
+          await mkdir(path.dirname(statePath), { recursive: true, mode: 0o700 })
+          const unlock = await lockFile(statePath)
+          try {
+            const state = await readDisk(statePath)
+            let changed = false
+            const result = await operation({
+              get: async (kind, id) => structuredClone(state.records[recordKey(kind, id)]),
+              list: async (kind) =>
+                Object.entries(state.records)
+                  .filter(([key]) => JSON.parse(key)[0] === kind)
+                  .map(([, value]) => structuredClone(value)),
+              put: async (kind, id, value) => {
+                state.records[recordKey(kind, id)] = structuredClone(value)
+                changed = true
+              },
+              insert: async (kind, id, value) => {
+                const key = recordKey(kind, id)
+                if (Object.hasOwn(state.records, key)) return false
+                state.records[key] = structuredClone(value)
+                changed = true
+                return true
+              },
+              remove: async (kind, id) => {
+                delete state.records[recordKey(kind, id)]
+                changed = true
+              },
+            })
+            if (changed) await persist(statePath, state)
+            return result
+          } finally {
+            await unlock()
+          }
+        })
+      const tail = current.then(
+        () => undefined,
+        () => undefined
+      )
+      queues.set(statePath, tail)
+      try {
+        return await current
+      } finally {
+        if (queues.get(statePath) === tail) queues.delete(statePath)
+      }
+    },
+    async close() {
+      await queues.get(statePath)
+    },
+  }
+}
+
+/** Per-record SQL storage; operation/binding locks serialize only the relevant intent. */
+export async function createPostgresDeviceAuthorizationStore(
+  databaseUrl: string
+): Promise<DeviceAuthorizationStore> {
+  const sql = postgres(databaseUrl, { max: 4, prepare: false, connect_timeout: 5 })
+  await sql`create table if not exists remote_device_authorization_records (
+    kind text not null, id text not null, payload jsonb not null, updated_at timestamptz not null default now(), primary key(kind,id)
+  )`
+  return {
+    async transaction(locks, operation) {
+      return await sql
+        .begin(async (transaction) => {
+          for (const key of [...new Set(locks)].sort())
+            await transaction`select pg_advisory_xact_lock(hashtextextended(${`ewdap:${key}`}, 0))`
+          const result = await operation({
+            async get(kind, id) {
+              const rows =
+                await transaction`select payload from remote_device_authorization_records where kind=${kind} and id=${id}`
+              return rows[0]?.payload as unknown
+            },
+            async list(kind) {
+              const rows =
+                await transaction`select payload from remote_device_authorization_records where kind=${kind}`
+              return rows.map((row) => row.payload as unknown)
+            },
+            async put(kind, id, value) {
+              await transaction`insert into remote_device_authorization_records(kind,id,payload) values(${kind},${id},${transaction.json(value as postgres.JSONValue)}) on conflict(kind,id) do update set payload=excluded.payload,updated_at=now()`
+            },
+            async insert(kind, id, value) {
+              const inserted =
+                await transaction`insert into remote_device_authorization_records(kind,id,payload) values(${kind},${id},${transaction.json(value as postgres.JSONValue)}) on conflict(kind,id) do nothing returning id`
+              return inserted.length === 1
+            },
+            async remove(kind, id) {
+              await transaction`delete from remote_device_authorization_records where kind=${kind} and id=${id}`
+            },
+          })
+          return { value: result }
+        })
+        .then((result) => result.value)
+    },
+    async close() {
+      await sql.end({ timeout: 5 })
+    },
+  }
+}
diff --git a/apps/remote-access-service/src/device-authorization/websocket.ts b/apps/remote-access-service/src/device-authorization/websocket.ts
new file mode 100644
index 0000000..297895a
--- /dev/null
+++ b/apps/remote-access-service/src/device-authorization/websocket.ts
@@ -0,0 +1,115 @@
+import { EWDAP_API_PREFIX } from "@easyai-desktop/remote-access"
+import type { Hono, Env } from "hono"
+import type { UpgradeWebSocket, WSEvents, WSContext } from "hono/ws"
+
+import { DeviceAuthorizationError } from "./crypto.js"
+import {
+  authenticateDeviceAuthorizationMobile,
+  assertDeviceAuthorizationScope,
+  type DeviceAuthorizationHttpOptions,
+} from "./http-app.js"
+
+export function registerDeviceAuthorizationWebSocket<E extends Env, T>(
+  app: Hono<E>,
+  upgrade: UpgradeWebSocket<T>,
+  options: DeviceAuthorizationHttpOptions,
+  sockets: Map<string, Set<{ close(code?: number, reason?: string): void }>>
+) {
+  app.get(`${EWDAP_API_PREFIX}/relay/ws`, async (context, next) => {
+    try {
+      const principal = await authenticateDeviceAuthorizationMobile(context, options)
+      assertDeviceAuthorizationScope(principal, "relay:read")
+      assertDeviceAuthorizationScope(principal, "relay:write")
+      let unsubscribe: (() => void) | undefined
+      let heartbeat: ReturnType<typeof setInterval> | undefined
+      let closed = false
+      let outbound = Promise.resolve()
+      const current = async () => {
+        const authorized = await options.service.authorize(principal.token, principal.thumbprint)
+        if (options.featurePolicy && !(await options.featurePolicy.isEnabled(authorized.identity)))
+          throw new DeviceAuthorizationError("feature_disabled", 403)
+        return authorized
+      }
+      const cleanup = (socket: WSContext<T>) => {
+        closed = true
+        unsubscribe?.()
+        if (heartbeat) clearInterval(heartbeat)
+        const registered = sockets.get(principal.identity.deviceId)
+        registered?.delete(socket)
+        if (!registered?.size) sockets.delete(principal.identity.deviceId)
+      }
+      const events: WSEvents<T> = {
+        async onOpen(_event, socket) {
+          try {
+            await current()
+            const registered = sockets.get(principal.identity.deviceId) ?? new Set()
+            registered.add(socket)
+            sockets.set(principal.identity.deviceId, registered)
+            unsubscribe = options.relayMailbox.subscribe(
+              principal.identity.deviceId,
+              (envelope) => {
+                if (envelope.bindingId !== principal.binding.bindingId) return
+                outbound = outbound
+                  .then(async () => {
+                    await current()
+                    if (!closed) socket.send(JSON.stringify(envelope))
+                  })
+                  .catch(() => {
+                    cleanup(socket)
+                    socket.close(4003, "authorization inactive")
+                  })
+              }
+            )
+            heartbeat = setInterval(() => {
+              void current().catch(() => {
+                cleanup(socket)
+                socket.close(4003, "authorization inactive")
+              })
+            }, 1_000)
+          } catch {
+            cleanup(socket)
+            socket.close(4003, "authorization inactive")
+          }
+        },
+        async onMessage(event, socket) {
+          try {
+            if (typeof event.data !== "string" || event.data.length > 16 * 1_024 * 1_024 || closed)
+              throw new Error("invalid envelope")
+            const authorized = await current()
+            const input: unknown = JSON.parse(event.data)
+            if (
+              typeof input !== "object" ||
+              !input ||
+              !("bindingId" in input) ||
+              input.bindingId !== authorized.binding.bindingId
+            )
+              throw new Error("binding mismatch")
+            await options.relayGuard.acceptAndPublish(
+              authorized.identity,
+              input,
+              options.relayMailbox
+            )
+          } catch {
+            cleanup(socket)
+            socket.close(4003, "authorization inactive")
+          }
+        },
+        onClose(_event, socket) {
+          cleanup(socket)
+        },
+        onError(_event, socket) {
+          cleanup(socket)
+        },
+      }
+      return await upgrade(() => events)(context, next)
+    } catch (error) {
+      const status = error instanceof DeviceAuthorizationError ? error.status : 503
+      return new Response(
+        JSON.stringify({
+          error: { code: error instanceof DeviceAuthorizationError ? error.code : "unavailable" },
+        }),
+        { status, headers: { "Content-Type": "application/json", "Cache-Control": "no-store" } }
+      )
+    }
+  })
+}
