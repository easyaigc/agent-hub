diff --git a/apps/desktop/src/renderer/src/features/settings/RemoteDeviceAuthorizationCard.tsx b/apps/desktop/src/renderer/src/features/settings/RemoteDeviceAuthorizationCard.tsx
new file mode 100644
index 0000000..710e535
--- /dev/null
+++ b/apps/desktop/src/renderer/src/features/settings/RemoteDeviceAuthorizationCard.tsx
@@ -0,0 +1,149 @@
+import type { RemoteAccessStateDto } from "@easyai-desktop/shared"
+import { LoaderCircle, ShieldCheck, ShieldX } from "lucide-react"
+import { QRCodeSVG } from "qrcode.react"
+
+import { Button } from "@/shadcn/ui/button"
+import { SettingsCard, SettingsRow } from "./SettingsLayout"
+
+type Offer = NonNullable<RemoteAccessStateDto["deviceOffer"]>
+export function RemoteDeviceAuthorizationCard(props: {
+  offer?: Offer
+  now: number
+  ready: boolean
+  pending?: string
+  onCreate: () => void
+  onDecision: (claim: NonNullable<Offer["claim"]>, decision: "approve" | "reject") => void
+}) {
+  const offer = props.offer
+  const expired = offer ? Date.parse(offer.expiresAt) <= props.now : false
+  const awaiting = offer?.status === "pending" && !expired ? offer.claim : undefined
+  const creating = props.pending === "device-offer"
+  const approving = props.pending === "device-approve"
+  const rejecting = props.pending === "device-reject"
+  const status = !offer
+    ? "生成连接码后，用手机扫码或输入连接码。"
+    : offer.status === "approved"
+      ? "设备已授权，可以安全连接本电脑。"
+      : offer.status === "rejected"
+        ? "已拒绝本次设备授权。"
+        : offer.status === "revoked"
+          ? "本次设备授权已撤销。"
+          : expired || offer.status === "expired"
+            ? "连接码已过期，请重新生成。"
+            : awaiting
+              ? "有手机请求连接，请核对设备和校验码后决定。"
+              : "等待手机扫码或输入连接码。"
+  return (
+    <div role="group" aria-label="手机设备授权">
+      <SettingsCard>
+        <SettingsRow
+          title="手机设备授权"
+          description="手机无需账户登录。连接码有效五分钟，只允许一台手机申请；须由本电脑明确确认。"
+        >
+          <Button
+            type="button"
+            variant="outline"
+            size="sm"
+            disabled={!props.ready || Boolean(props.pending)}
+            aria-busy={creating}
+            onClick={props.onCreate}
+          >
+            {creating ? (
+              <LoaderCircle data-icon="inline-start" className="animate-spin" />
+            ) : (
+              <ShieldCheck data-icon="inline-start" />
+            )}
+            {creating ? "正在生成连接码…" : "生成设备连接码"}
+          </Button>
+        </SettingsRow>
+        <div className="flex flex-col gap-3 border-t px-4 py-3 text-sm">
+          <p role="status" aria-live="polite">
+            {approving
+              ? "正在确认设备授权…"
+              : rejecting
+                ? "正在拒绝设备授权…"
+                : creating
+                  ? "正在生成设备连接码…"
+                  : status}
+          </p>
+          {offer?.deepLink && !expired && ["offered", "pending"].includes(offer.status) ? (
+            <div className="flex flex-wrap items-center gap-4">
+              <QRCodeSVG value={offer.deepLink} size={120} aria-label="免登录设备配对二维码" />
+              <div className="flex flex-col gap-1">
+                <p className="font-mono text-base tracking-wider">
+                  {offer.connectionCode?.match(/.{1,4}/gu)?.join(" ")}
+                </p>
+                <p className="text-xs text-muted-foreground">
+                  剩余 {Math.max(0, Math.ceil((Date.parse(offer.expiresAt) - props.now) / 1_000))}{" "}
+                  秒
+                </p>
+              </div>
+            </div>
+          ) : null}
+          {awaiting ? (
+            <div className="flex flex-col gap-2">
+              <p className="font-medium">
+                {awaiting.device.name} ·{" "}
+                {awaiting.device.platform === "android" ? "Android" : "iOS"}
+              </p>
+              <p className="text-xs break-all text-muted-foreground">
+                设备 ID：{awaiting.device.deviceId}
+              </p>
+              <p className="text-xs break-all text-muted-foreground">
+                加密公钥：{awaiting.device.publicKey}
+              </p>
+              <p className="text-xs break-all text-muted-foreground">
+                授权公钥：{awaiting.device.authPublicKey.x} / {awaiting.device.authPublicKey.y}
+              </p>
+              <p>
+                核对手机显示的校验码：
+                <strong className="font-mono">{awaiting.verificationCode}</strong>
+              </p>
+              <p className="text-xs break-all text-muted-foreground">
+                账户：{offer!.target.account.authority} / {offer!.target.account.subject}
+              </p>
+              <p className="text-xs break-all text-muted-foreground">
+                目标：{offer!.target.desktopDeviceId} / {offer!.target.workspaceId} /{" "}
+                {offer!.target.runtimeId}
+              </p>
+              <p className="text-xs text-muted-foreground">
+                允许远程查看、任务控制和文件传输；仍受本电脑的任务及文件权限限制。设备名称由手机自报。
+              </p>
+              <div className="flex flex-wrap gap-2">
+                <Button
+                  type="button"
+                  size="sm"
+                  disabled={Boolean(props.pending)}
+                  aria-busy={approving}
+                  onClick={() => props.onDecision(awaiting, "approve")}
+                >
+                  {approving ? (
+                    <LoaderCircle data-icon="inline-start" className="animate-spin" />
+                  ) : (
+                    <ShieldCheck data-icon="inline-start" />
+                  )}
+                  {approving ? "正在确认授权…" : "确认授权"}
+                </Button>
+                <Button
+                  type="button"
+                  size="sm"
+                  variant="outline"
+                  disabled={Boolean(props.pending)}
+                  aria-busy={rejecting}
+                  onClick={() => props.onDecision(awaiting, "reject")}
+                >
+                  {rejecting ? (
+                    <LoaderCircle data-icon="inline-start" className="animate-spin" />
+                  ) : (
+                    <ShieldX data-icon="inline-start" />
+                  )}
+                  {rejecting ? "正在拒绝授权…" : "拒绝授权"}
+                </Button>
+              </div>
+            </div>
+          ) : null}
+        </div>
+      </SettingsCard>
+    </div>
+  )
+}
