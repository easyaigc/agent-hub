@@ -0,0 +1,50 @@
+import {
+  pairingOfferSchema,
+  type PairingOfferView,
+  type PublicPairingOffer,
+  type RemoteBinding,
+} from "@easyai-desktop/remote-access"
+import { z } from "zod"
+
+import { isRemoteAccessRequestStatus, remoteAccessApi as api } from "./remote-access-http.js"
+
+export async function createLegacyDesktopOffer(input: {
+  target: RemoteBinding["target"]
+  previous?: PublicPairingOffer | PairingOfferView
+  request: (path: string, init: RequestInit) => Promise<unknown>
+}) {
+  if (input.previous && ["available", "claimed"].includes(input.previous.status)) {
+    try {
+      await input.request(api(`/pairing/${encodeURIComponent(input.previous.offerId)}`), {
+        method: "DELETE",
+      })
+    } catch (error) {
+      if (!isRemoteAccessRequestStatus(error, 404)) throw error
+    }
+  }
+  return pairingOfferSchema
+    .omit({ pairingCodeDigest: true })
+    .extend({ pairingCode: z.string().length(6) })
+    .parse(
+      await input.request(api("/pairing/offers"), {
+        method: "POST",
+        body: JSON.stringify({ target: input.target, pairingMode: "temporary_password" }),
+      })
+    )
+}
+export async function createLegacyPermanentPasswordOffer(input: {
+  target: RemoteBinding["target"]
+  password: string
+  request: (path: string, init: RequestInit) => Promise<unknown>
+}) {
+  return pairingOfferSchema.omit({ pairingCodeDigest: true }).parse(
+    await input.request(api("/pairing/offers"), {
+      method: "POST",
+      body: JSON.stringify({
+        target: input.target,
+        pairingMode: "permanent_password",
+        pairingPassword: input.password,
+      }),
+    })
+  )
+}
