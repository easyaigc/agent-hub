HOST_AGENT_BIND_ADDRESS=127.0.0.1
HOST_AGENT_PORT=8788
CODEX_HISTORY_READ=0
# History mode is an explicit, loopback-only development connection.
# CODEX_EXECUTABLE=codex
# HOST_AGENT_STATE_DIR=.local/host-agent
# Full runtime is explicit. Use a private persistent state directory outside the repository.
# CODEX_RUNTIME_MODE=managed-runtime
# HOST_AGENT_ROOT=/path/to/authorized/projects
# HOST_AGENT_STATE_DIR=/path/to/private/state
# HOST_AGENT_BIND=127.0.0.1
# Shared mode attaches to an already-open socket, never starts a second desktop runtime.
# CODEX_RUNTIME_MODE=shared-runtime
# CODEX_SOCKET=/path/to/already-shared/app-server.sock
# Non-loopback listeners require TLS.
# HOST_AGENT_TLS_CERT=/path/to/certificate.pem
# HOST_AGENT_TLS_KEY=/path/to/private-key.pem
# Task notifications: a private token unique to this Host. APNs keys stay on the relay.
# HOST_NOTIFICATION_RELAY_URL=https://notifications.example
# HOST_NOTIFICATION_PUBLISHER_TOKEN_FILE=/path/to/private/publisher-token
