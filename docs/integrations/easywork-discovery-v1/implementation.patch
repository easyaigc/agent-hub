diff --git a/apps/desktop/test/main/remote-access/local-computer.test.ts b/apps/desktop/test/main/remote-access/local-computer.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/test/main/remote-access/local-computer.test.ts
@@ -0,0 +1,30 @@
+import { hostname, platform, userInfo } from "node:os"
+import { expect, test } from "vitest"
+import {
+  computerDisplayName,
+  computerServiceName,
+  localComputer,
+} from "../../../src/main/remote-access/local-computer.js"
+
+test("local computer display associates the OS hostname and username", () => {
+  const computer = localComputer()
+  expect(computer).toEqual({ name: hostname(), username: userInfo().username, platform: platform() })
+  expect(computerDisplayName(computer)).toBe(`EasyWork ${hostname()} · ${userInfo().username}`)
+  expect(computerDisplayName({ name: "Workstation", username: undefined, platform: platform() })).toBe(
+    "EasyWork Workstation"
+  )
+})
+
+test("Bonjour names fit 63 UTF-8 bytes without splitting characters and distinguish device suffixes", () => {
+  const display = `EasyWork ${"电脑😀".repeat(30)}`
+  const first = computerServiceName(display, "device-8-00000001")
+  const second = computerServiceName(display, "device-8-00000002")
+  expect(first).not.toBe(second)
+  expect(first.endsWith(" [00000001]")).toBe(true)
+  expect(second.endsWith(" [00000002]")).toBe(true)
+  for (const name of [first, second]) {
+    expect(Buffer.byteLength(name, "utf8")).toBeLessThanOrEqual(63)
+    expect(name).not.toContain("\uFFFD")
+    expect(display.startsWith(name.slice(0, -11))).toBe(true)
+  }
+})
