{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only notification original archive index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "installations"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "installations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/installation"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "publicKey", "fingerprint"],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "publicKey": {
          "type": "string",
          "maxLength": 64
        },
        "fingerprint": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveId",
        "installation",
        "originalIdentitySha256",
        "requiresOriginalInstallation",
        "missingAuthorizations",
        "foreground-v1",
        "recovery-v2",
        "authorizations-v1"
      ],
      "properties": {
        "archiveId": {
          "$ref": "#/$defs/hash"
        },
        "installation": {
          "oneOf": [
            {
              "$ref": "#/$defs/context"
            },
            {
              "type": "null"
            }
          ]
        },
        "originalIdentitySha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "requiresOriginalInstallation": {
          "const": true
        },
        "missingAuthorizations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "foreground-v1": {
          "$ref": "#/$defs/nullableHash"
        },
        "recovery-v2": {
          "$ref": "#/$defs/nullableHash"
        },
        "authorizations-v1": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    }
  },
  "description": "Native validation additionally enforces <=128KiB strict UTF8/index integer tokens, canonical unique archiveId over exact descriptor without archiveId, public-key fingerprint and context/identity-hash null parity. Non-null original hashes resolve exact raw records migration-notification-original-v1:<archiveId>:<kind>; every record must be claimed. Frozen v1/v2 journal, intent/receipt/feed/reset/authority parsers and cross-target/installation/authorization graphs validate in full. missingAuthorizations is the exact sorted referenced-minus-retained set. Source private identity never portable. These names are disjoint from active P9 records and never activate source authority."
}
