diff --git a/apps/desktop/src/main/remote-access/local-computer.ts b/apps/desktop/src/main/remote-access/local-computer.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/main/remote-access/local-computer.ts
@@ -0,0 +1,26 @@
+import { hostname, platform, userInfo } from "node:os"
+
+/** Display metadata only; authorization remains bound to the original runtime target. */
+export function localComputer() {
+  let username: string | undefined
+  try {
+    username = userInfo().username || undefined
+  } catch {
+    // Hosts without a resolvable OS user still advertise their computer name.
+  }
+  return { name: hostname(), username, platform: platform() }
+}
+
+export function computerDisplayName(computer: ReturnType<typeof localComputer>): string {
+  return `EasyWork ${computer.name}${computer.username ? ` · ${computer.username}` : ""}`
+}
+
+export function computerServiceName(name: string, deviceId: string): string {
+  const suffix = ` [${deviceId.slice(-8)}]`
+  let prefix = ""
+  for (const character of name) {
+    if (Buffer.byteLength(prefix + character + suffix, "utf8") > 63) break
+    prefix += character
+  }
+  return prefix + suffix
+}
