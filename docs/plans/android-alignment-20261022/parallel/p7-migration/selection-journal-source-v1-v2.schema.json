{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hub:source:selection-journal:v1-v2",
  "title": "Existing selection journal source v1/v2; not a portable archive catalog",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "records"],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "records": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "generation",
              "selection",
              "requestId",
              "errorGeneration",
              "phase",
              "sources",
              "releaseReadGrants"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              },
              "selection": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "errorGeneration": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "phase": {
                "enum": [
                  "permission",
                  "prepared",
                  "launched",
                  "selected",
                  "ready",
                  "detached",
                  "hold-selected",
                  "held",
                  "consumed",
                  "retired",
                  "failed"
                ]
              },
              "sources": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^content://[^/?#]+[^#]*$"
                }
              },
              "releaseReadGrants": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "records"],
      "properties": {
        "version": {
          "const": 2
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "records": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "generation",
              "selection",
              "requestId",
              "errorGeneration",
              "phase",
              "sources",
              "releaseReadGrants",
              "maximum"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "generation": {
                "type": "string",
                "format": "uuid"
              },
              "selection": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              },
              "errorGeneration": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "phase": {
                "enum": [
                  "permission",
                  "prepared",
                  "launched",
                  "selected",
                  "ready",
                  "detached",
                  "hold-selected",
                  "held",
                  "consumed",
                  "retired",
                  "failed"
                ]
              },
              "sources": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^content://[^/?#]+[^#]*$"
                }
              },
              "releaseReadGrants": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "maximum": {
                "enum": [5, 10]
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Runtime component additionally checks <=8MiB UTF8; canonical UUIDs; exact integer types; source original raw retained; unique request IDs; at most one permission/prepared/launched; source/grant order/subset/maximum; camera-only phases. No URI/grant/callback methods are returned. Child reader, producer ownership, raw camera inventory and portable catalog remain unimplemented."
}
