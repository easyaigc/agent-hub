+      expect((await f.request("/v2/remote-access/bindings", "GET", grant.accessToken)).status).toBe(
+        200
+      )
+      const encoded = paired.claim.view.sealedDelivery!
+      const privateJwk = await importJWK(
+        { kty: "OKP", crv: "X25519", x: f.mobileKeys.publicKey, d: f.mobileKeys.privateKey },
+        "ECDH-ES"
+      )
+      const decrypted = await compactDecrypt(encoded, privateJwk)
+      const payload = JSON.parse(new TextDecoder().decode(decrypted.plaintext)) as {
+        claimId: string
+      }
+      expect(payload.claimId).toBe(paired.claim.view.claimId)
+      if (storage === "local") {
