{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codex-manage.example/contracts/agent-management/v1",
  "title": "Agent management v1",
  "definitions": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "subject"],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "hostId", "workspaceId", "runtimeId"],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "runtimeId": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "$ref": "#/definitions/account"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transportId", "endpoint"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "transportId": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        },
        "peerFingerprint": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "networkKind": {
          "type": "string",
          "enum": ["lan", "vpn", "unknown"]
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "candidates", "preference", "credentialRef"],
      "properties": {
        "target": {
          "$ref": "#/definitions/target"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/candidate"
          }
        },
        "preference": {
          "enum": ["automatic", "lan-only", "relay-only"]
        },
        "credentialRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "available"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "parts", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["user", "assistant", "tool"]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/part"
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "target", "state"],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": ["received", "submitting", "completed", "failed", "uncertain"]
        },
        "result": {},
        "error": {
          "type": "string"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "threadId", "epoch", "sequence"],
      "properties": {
        "target": {
          "$ref": "#/definitions/target"
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "name", "roots"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "title", "state"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "state": {
          "enum": ["unknown", "idle", "running", "waiting-for-approval", "failed"]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "threadId", "name", "mediaType", "sizeBytes", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "threadId",
        "runId",
        "kind",
        "title",
        "detail",
        "decisions",
        "questions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["permission", "question"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question", "options"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "description"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "multiple": {
                "type": "boolean"
              },
              "custom": {
                "type": "boolean"
              },
              "isSecret": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resourceId", "name", "mediaType"],
          "properties": {
            "type": {
              "const": "resource"
            },
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "mediaType": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "name", "status"],
          "properties": {
            "type": {
              "const": "tool"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "text"],
          "properties": {
            "type": {
              "const": "diff"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "namespace", "data"],
          "properties": {
            "type": {
              "const": "extension"
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "object"
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "target", "operationId", "command"],
      "properties": {
        "version": {
          "const": 1
        },
        "target": {
          "$ref": "#/definitions/target"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": {
                "operation": {
                  "const": "thread.create"
                },
                "projectId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "parts"],
              "properties": {
                "operation": {
                  "const": "message.send"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/part"
                  }
                },
                "mode": {
                  "enum": ["next-turn", "queue", "steer"]
                },
                "expectedRunId": {
                  "type": "string",
                  "minLength": 1
                },
                "settings": {
                  "$ref": "#/definitions/generationSettings"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "runId"],
              "properties": {
                "operation": {
                  "const": "run.stop"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "approvalId", "decision"],
              "properties": {
                "operation": {
                  "const": "approval.respond"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "approvalId", "answers"],
              "properties": {
                "operation": {
                  "const": "question.answer"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1
                },
                "answers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "resourceId"],
              "properties": {
                "operation": {
                  "const": "resource.read"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "operationId"],
              "properties": {
                "operation": {
                  "const": "operation.status"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "operationId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": {
                "operation": {
                  "const": "models.list"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "planId", "version"],
              "properties": {
                "operation": {
                  "const": "plan.approve"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "planId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "settings": {
                  "$ref": "#/definitions/generationSettings"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "planId", "version", "parts"],
              "properties": {
                "operation": {
                  "const": "plan.revise"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "planId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/part"
                  }
                },
                "settings": {
                  "$ref": "#/definitions/generationSettings"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "messageId"],
              "properties": {
                "operation": {
                  "const": "queue.cancel"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "messageId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "threadId", "messageId"],
              "properties": {
                "operation": {
                  "const": "queue.execute"
                },
                "threadId": {
                  "type": "string",
                  "minLength": 1
                },
                "messageId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedRunId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "connectionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "phase", "processHealthy", "runtimeConnected", "historyReadable"],
      "properties": {
        "target": {
          "$ref": "#/definitions/target"
        },
        "phase": {
          "enum": ["disconnected", "connecting", "connected", "recovering"]
        },
        "transportId": {
          "type": "string",
          "minLength": 1
        },
        "processHealthy": {
          "type": "boolean"
        },
        "runtimeConnected": {
          "type": "boolean"
        },
        "historyReadable": {
          "type": "boolean"
        }
      }
    },
    "generationSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "permissionMode": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["normal", "plan"]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "isDefault", "supportedEfforts"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "isDefault": {
          "type": "boolean"
        },
        "supportedEfforts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "runId", "status", "text", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "status"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/definitions/connection"
}
