diff --git a/apps/desktop/src/main/remote-access/desktop-device-authorization.ts b/apps/desktop/src/main/remote-access/desktop-device-authorization.ts
new file mode 100644
index 0000000..6b503ef
--- /dev/null
+++ b/apps/desktop/src/main/remote-access/desktop-device-authorization.ts
@@ -0,0 +1,304 @@
+import { randomUUID } from "node:crypto"
+import { mkdir, open, readFile, rename } from "node:fs/promises"
+import path from "node:path"
+
+import {
+  deviceAuthorizationStateSchema,
+  deviceAuthorizationTargetKey,
+  deviceDescriptorSchema,
+  deviceOfferViewSchema,
+  EWDAP_API_PREFIX,
+  openDeviceAuthorizationDelivery,
+  type DeviceOfferView,
+  type RemoteBinding,
+  type RemoteDeviceIdentity,
+} from "@easyai-desktop/remote-access"
+import { z } from "zod"
+import type { AgentProtocolV2Request } from "@easyai-desktop/agent-protocol"
+
+const stateSchema = z
+  .object({
+    version: z.literal(1),
+    offer: deviceOfferViewSchema.optional(),
+    revoked: z.array(z.string()),
+    operations: z.record(
+      z.string(),
+      z.object({ operationId: z.string(), body: z.string() }).strict()
+    ),
+  })
+  .strict()
+type State = z.infer<typeof stateSchema>
+export type DesktopDeviceOffer = DeviceOfferView & {
+  readonly connectionCode?: string
+  readonly deepLink?: string
+}
+export type DesktopDeviceAuthorizationContext = {
+  readonly privateKey: string
+  readonly identity: RemoteDeviceIdentity
+  readonly target: RemoteBinding["target"]
+}
+
+export class DesktopDeviceAuthorizationClient {
+  #state: State = { version: 1, revoked: [], operations: {} }
+  #loaded = false
+  #offer?: DesktopDeviceOffer
+  #queue = Promise.resolve()
+  constructor(
+    private readonly options: {
+      request: (path: string, init?: RequestInit) => Promise<unknown>
+      context: () => Promise<DesktopDeviceAuthorizationContext>
+      statePath?: string
+      onLocalRevoked: (bindingId: string) => Promise<void>
+    }
+  ) {}
+  getOffer() {
+    return this.#offer
+  }
+  async #load() {
+    if (this.#loaded) return
+    if (this.options.statePath) {
+      try {
+        this.#state = stateSchema.parse(JSON.parse(await readFile(this.options.statePath, "utf8")))
+      } catch (error) {
+        if (!(error instanceof Error) || !("code" in error) || error.code !== "ENOENT") throw error
+      }
+    }
+    this.#loaded = true
+  }
+  async #save() {
+    if (!this.options.statePath) return
+    await mkdir(path.dirname(this.options.statePath), { recursive: true, mode: 0o700 })
+    const temporary = `${this.options.statePath}.${randomUUID()}.tmp`
+    const file = await open(temporary, "wx", 0o600)
+    try {
+      await file.writeFile(JSON.stringify(this.#state))
+      await file.sync()
+    } finally {
+      await file.close()
+    }
+    await rename(temporary, this.options.statePath)
+  }
+  async #serialized<T>(operation: () => Promise<T>): Promise<T> {
+    const pending = this.#queue.then(operation, operation)
+    this.#queue = pending.then(
+      () => undefined,
+      () => undefined
+    )
+    return await pending
+  }
+  async #intent(key: string, body: object) {
+    await this.#load()
+    const json = JSON.stringify(body)
+    const previous = this.#state.operations[key]
+    if (previous && previous.body !== json) throw new Error("设备授权操作的原意图不能修改")
+    if (previous) return { ...body, operationId: previous.operationId }
+    const operationId = randomUUID()
+    this.#state.operations[key] = { operationId, body: json }
+    await this.#save()
+    return { ...body, operationId }
+  }
+  async #present(offer: DeviceOfferView) {
+    const context = await this.options.context()
+    if (
+      deviceAuthorizationTargetKey(context.target) !== deviceAuthorizationTargetKey(offer.target) ||
+      context.identity.publicKey !== offer.desktop.publicKey
+    )
+      throw new Error("配对描述不属于当前电脑目标")
+    let connectionCode: string | undefined, deepLink: string | undefined
+    if (
+      offer.sealedDescriptor &&
+      ["offered", "pending"].includes(offer.status) &&
+      Date.parse(offer.expiresAt) > Date.now()
+    ) {
+      const descriptor = deviceDescriptorSchema.parse(
+        await openDeviceAuthorizationDelivery(
+          context.privateKey,
+          offer.sealedDescriptor,
+          offer.offerId
+        )
+      )
+      if (
+        descriptor.offerId !== offer.offerId ||
+        deviceAuthorizationTargetKey(descriptor.target) !==
+          deviceAuthorizationTargetKey(context.target) ||
+        descriptor.desktopPublicKey !== context.identity.publicKey
+      )
+        throw new Error("配对密文目标不符")
+      connectionCode = descriptor.connectionCode
+      deepLink = `easywork://pair?version=1&relay=${encodeURIComponent(descriptor.relayOrigin)}&code=${encodeURIComponent(connectionCode)}`
+    }
+    this.#offer = { ...offer, ...(connectionCode ? { connectionCode, deepLink } : {}) }
+    return this.#offer
+  }
+  async createOffer() {
+    return await this.#serialized(async () => {
+      const context = await this.options.context()
+      const key = `offer:${deviceAuthorizationTargetKey(context.target)}`
+      const request = await this.#intent(key, { target: context.target })
+      const offer = deviceOfferViewSchema.parse(
+        await this.options.request(`${EWDAP_API_PREFIX}/pairing/offers`, {
+          method: "POST",
+          body: JSON.stringify(request),
+        })
+      )
+      this.#state.offer = offer
+      delete this.#state.operations[key]
+      await this.#save()
+      return await this.#present(offer)
+    })
+  }
+  async refresh() {
+    return await this.#serialized(async () => {
+      await this.#load()
+      if (!this.#state.offer) return undefined
+      const context = await this.options.context()
+      if (
+        deviceAuthorizationTargetKey(context.target) !==
+        deviceAuthorizationTargetKey(this.#state.offer.target)
+      ) {
+        this.#offer = undefined
+        return undefined
+      }
+      const view = deviceOfferViewSchema.parse(
+        await this.options.request(
+          `${EWDAP_API_PREFIX}/pairing/offers/${encodeURIComponent(this.#state.offer.offerId)}`
+        )
+      )
+      this.#state.offer = { ...view, sealedDescriptor: this.#state.offer.sealedDescriptor }
+      await this.#save()
+      return await this.#present(this.#state.offer)
+    })
+  }
+  async decide(claimId: string, decision: "approve" | "reject", transcriptHash: string) {
+    return await this.#serialized(async () => {
+      const request = await this.#intent(`decision:${claimId}`, { decision, transcriptHash })
+      await this.options.request(
+        `${EWDAP_API_PREFIX}/pairing/claims/${encodeURIComponent(claimId)}/decision`,
+        { method: "POST", body: JSON.stringify(request) }
+      )
+    })
+  }
+  async revoke(binding: RemoteBinding) {
+    const authorization = binding.deviceAuthorization
+    if (!authorization) throw new Error("binding has no EWDAP grant")
+    await this.#serialized(async () => {
+      await this.#load()
+      if (!this.#state.revoked.includes(binding.bindingId))
+        this.#state.revoked.push(binding.bindingId)
+      await this.#save()
+      await this.options.onLocalRevoked(binding.bindingId)
+      const request = await this.#intent(`revoke:${authorization.grantId}`, {})
+      await this.options.request(
+        `${EWDAP_API_PREFIX}/device-grants/${encodeURIComponent(authorization.grantId)}`,
+        { method: "DELETE", body: JSON.stringify(request) }
+      )
+    })
+  }
+  async assertBinding(binding: RemoteBinding) {
+    const context = await this.options.context()
+    if (
+      deviceAuthorizationTargetKey(context.target) !==
+        deviceAuthorizationTargetKey(binding.target) ||
+      context.identity.publicKey !== binding.desktopPublicKey
+    )
+      throw new Error("设备授权不属于当前账户或电脑目标")
+    await this.#load()
+    if (this.#state.revoked.includes(binding.bindingId)) throw new Error("设备已在本电脑撤销")
+    const state = deviceAuthorizationStateSchema.parse(
+      await this.options.request(
+        `${EWDAP_API_PREFIX}/bindings/${encodeURIComponent(binding.bindingId)}/authorization`
+      )
+    )
+    const { grant, binding: current } = state
+    if (
+      grant.status !== "active" ||
+      current.status !== "active" ||
+      Date.parse(grant.expiresAt) <= Date.now() ||
+      grant.grantId !== binding.deviceAuthorization?.grantId ||
+      grant.keyVersion !== binding.deviceAuthorization.keyVersion ||
+      current.desktopPublicKey !== binding.desktopPublicKey ||
+      current.mobilePublicKey !== binding.mobilePublicKey ||
+      current.mobileDeviceId !== binding.mobileDeviceId ||
+      deviceAuthorizationTargetKey(current.target) !== deviceAuthorizationTargetKey(binding.target)
+    )
+      throw new Error("设备授权已过期、撤销或目标密钥已变化")
+    return state
+  }
+  async authorizeLanRequest(
+    binding: RemoteBinding,
+    request: {
+      authorization: string
+      proof: string
+      method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
+      url: string
+      bodyHash?: string
+    }
+  ) {
+    const context = await this.options.context()
+    if (
+      deviceAuthorizationTargetKey(context.target) !== deviceAuthorizationTargetKey(binding.target)
+    )
+      throw new Error("LAN设备授权不属于当前账户目标")
+    await this.#load()
+    if (this.#state.revoked.includes(binding.bindingId)) throw new Error("设备已在本电脑撤销")
+    const state = deviceAuthorizationStateSchema.parse(
+      await this.options.request(`${EWDAP_API_PREFIX}/device-grants/authorize-lan`, {
+        method: "POST",
+        body: JSON.stringify({
+          bindingId: binding.bindingId,
+          target: binding.target,
+          authorization: request.authorization,
+          proof: request.proof,
+          method: request.method,
+          htu: request.url,
+          ...(request.bodyHash ? { bodyHash: request.bodyHash } : {}),
+        }),
+      })
+    )
+    if (
+      state.binding.bindingId !== binding.bindingId ||
+      state.grant.grantId !== binding.deviceAuthorization?.grantId ||
+      state.grant.keyVersion !== binding.deviceAuthorization.keyVersion ||
+      deviceAuthorizationTargetKey(state.binding.target) !==
+        deviceAuthorizationTargetKey(binding.target)
+    )
+      throw new Error("LAN设备授权目标不符")
+    return state
+  }
+  async assertRequest(binding: RemoteBinding, request: AgentProtocolV2Request) {
+    const authorization = await this.assertBinding(binding)
+    const readMethods = new Set([
+      "runtime/context",
+      "runtime/summary",
+      "project/list",
+      "thread/list",
+      "thread/search",
+      "thread/read",
+      "thread/history",
+      "thread/sync",
+      "thread/subscribe",
+      "thread/unsubscribe",
+      "command/status",
+      "event/read",
+    ])
+    const scope = request.method.startsWith("resource/")
+      ? [
+          "resource/read",
+          "resource/resolve",
+          "resource/download",
+          "resource/transfer-list",
+          "resource/upload-status",
+        ].includes(request.method)
+        ? "files:read"
+        : "files:write"
+      : readMethods.has(request.method)
+        ? "runtime:read"
+        : "runtime:control"
+    if (!authorization.grant.scopes.includes(scope))
+      throw new Error("device permission scope denied")
+    if (
+      deviceAuthorizationTargetKey(request.target) !== deviceAuthorizationTargetKey(binding.target)
+    )
+      throw new Error("remote request target mismatch")
+  }
+}
