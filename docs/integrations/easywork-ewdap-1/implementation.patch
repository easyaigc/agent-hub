+import { canonicalDeviceAuthorizationJson } from "./device-authorization-json.js"
+import { runtimeTargetSchema } from "@easyai-desktop/agent-protocol"
+import { z } from "zod"
+
+import { remoteBindingSchema, remoteDeviceIdentitySchema } from "./contracts.js"
+
+export const EWDAP_PROTOCOL = "EWDAP/1" as const
+export const EWDAP_API_PREFIX = "/v2/remote-access"
+const id = z.string().trim().min(1).max(512)
+const encodedKey = z.string().regex(/^[A-Za-z0-9_-]{43}$/u)
+export const deviceAuthorizationPublicJwkSchema = z
+  .object({ kty: z.literal("EC"), crv: z.literal("P-256"), x: encodedKey, y: encodedKey })
+  .strict()
+export const deviceAuthorizationDeviceSchema = z
+  .object({
+    deviceId: id,
+    platform: z.enum(["android", "ios"]),
+    name: z.string().trim().min(1).max(100),
+    publicKey: encodedKey,
+    authPublicKey: deviceAuthorizationPublicJwkSchema,
+  })
+  .strict()
+export const deviceAuthorizationScopes = [
+  "relay:read",
+  "relay:write",
+  "runtime:read",
+  "runtime:control",
+  "files:read",
+  "files:write",
+] as const
+export const deviceAuthorizationScopeSchema = z.enum(deviceAuthorizationScopes)
+export const deviceOfferRequestSchema = z
+  .object({ operationId: z.uuid(), target: runtimeTargetSchema })
+  .strict()
+export const deviceClaimRequestSchema = z
+  .object({
+    operationId: z.uuid(),
+    connectionCode: z.string().regex(/^[0-9A-HJKMNP-TV-Z]{16}$/u),
+    device: deviceAuthorizationDeviceSchema,
+  })
+  .strict()
+export const deviceDecisionRequestSchema = z
+  .object({
+    operationId: z.uuid(),
+    decision: z.enum(["approve", "reject"]),
+    transcriptHash: encodedKey,
+  })
+  .strict()
+export const deviceOperationRequestSchema = z.object({ operationId: z.uuid() }).strict()
+export const deviceGrantDescriptionSchema = z
+  .object({
+    protocol: z.literal(EWDAP_PROTOCOL),
+    grantId: id,
+    bindingId: id,
+    deviceId: id,
+    target: runtimeTargetSchema,
+    keyVersion: z.number().int().positive(),
+    authKeyThumbprint: encodedKey,
+    scopes: z.array(deviceAuthorizationScopeSchema),
+    status: z.enum(["active", "revoked"]),
+    expiresAt: z.string().datetime(),
+  })
+  .strict()
+export const deviceOfferViewSchema = z
+  .object({
+    protocol: z.literal(EWDAP_PROTOCOL),
+    offerId: id,
+    target: runtimeTargetSchema,
+    desktop: remoteDeviceIdentitySchema,
+    expiresAt: z.string().datetime(),
+    status: z.enum(["offered", "pending", "approved", "rejected", "expired", "revoked"]),
+    sealedDescriptor: z.string().optional(),
+    claim: z
+      .object({
+        claimId: id,
+        device: deviceAuthorizationDeviceSchema,
+        transcriptHash: encodedKey,
+        verificationCode: z.string(),
+      })
+      .strict()
+      .optional(),
+  })
+  .strict()
+export const deviceDescriptorSchema = z
+  .object({
+    protocol: z.literal(EWDAP_PROTOCOL),
+    deliveryId: id,
+    offerId: id,
+    connectionCode: z.string(),
+    expiresAt: z.string().datetime(),
+    relayOrigin: z.url(),
+    desktopPublicKey: encodedKey,
+    target: runtimeTargetSchema,
+  })
+  .strict()
+export const deviceAuthorizationStateSchema = z
+  .object({
+    binding: remoteBindingSchema,
+    grant: deviceGrantDescriptionSchema,
+    protocol: z.literal(EWDAP_PROTOCOL),
+  })
+  .strict()
+export type DeviceAuthorizationPublicJwk = z.infer<typeof deviceAuthorizationPublicJwkSchema>
+export type DeviceAuthorizationDevice = z.infer<typeof deviceAuthorizationDeviceSchema>
+export type DeviceAuthorizationScope = z.infer<typeof deviceAuthorizationScopeSchema>
+export type DeviceGrantDescription = z.infer<typeof deviceGrantDescriptionSchema>
+export type DeviceOfferView = z.infer<typeof deviceOfferViewSchema>
+export type DeviceClaimRequest = z.infer<typeof deviceClaimRequestSchema>
+
+/** Conversation identity deliberately excludes binding, transport and key versions. */
+export function deviceAuthorizationTargetKey(target: z.infer<typeof runtimeTargetSchema>): string {
+  return canonicalDeviceAuthorizationJson(target)
+}
