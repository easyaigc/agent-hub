+import { createInterface } from "node:readline"
+import path from "node:path"
+
+import { serve } from "@hono/node-server"
+import { createNodeWebSocket } from "@hono/node-ws"
+import { getConnInfo } from "@hono/node-server/conninfo"
+import {
+  EncryptedRelayGuard,
+  PairingService,
+  remoteDeviceIdentitySchema,
+} from "@easyai-desktop/remote-access"
+import { z } from "zod"
+
+import { createStaticRemoteAuthVerifier } from "../../src/auth.js"
+import { createRemoteAccessHttpApp } from "../../src/http-app.js"
+import { createPersistentLocalRemoteRuntime } from "../../src/local-runtime.js"
+import { createPostgresRemoteAccessRepository } from "../../src/postgres-repository.js"
+import {
+  createLocalDeviceAuthorizationStore,
+  createPostgresDeviceAuthorizationStore,
+} from "../../src/device-authorization/store.js"
+import { DeviceAuthorizationService } from "../../src/device-authorization/service.js"
+import { withDeviceAuthorizationBindings } from "../../src/device-authorization/repository.js"
+import { registerDeviceAuthorizationWebSocket } from "../../src/device-authorization/websocket.js"
+
+const configurationSchema = z
+  .object({
+    directory: z.string(),
+    databaseUrl: z.string().optional(),
+    desktop: remoteDeviceIdentitySchema,
+    foreignDesktop: remoteDeviceIdentitySchema,
+    clock: z.number(),
+  })
+  .strict()
+export type EwdapHttpWorkerConfiguration = z.infer<typeof configurationSchema>
+const lines = createInterface({ input: process.stdin })
+const iterator = lines[Symbol.asyncIterator]()
+const initial = await iterator.next()
+const configuration = configurationSchema.parse(JSON.parse(initial.value ?? ""))
+let clock = configuration.clock
+const local = await createPersistentLocalRemoteRuntime({
+  statePath: path.join(configuration.directory, "legacy.json"),
+})
+const postgres = configuration.databaseUrl
+  ? createPostgresRemoteAccessRepository({
+      databaseUrl: configuration.databaseUrl,
+      defaultFeatureEnabled: true,
+    })
+  : undefined
+await postgres?.migrate()
+const store = configuration.databaseUrl
+  ? await createPostgresDeviceAuthorizationStore(configuration.databaseUrl)
+  : createLocalDeviceAuthorizationStore(path.join(configuration.directory, "ewdap.json"))
+const repository = withDeviceAuthorizationBindings(postgres ?? local.repository, store)
+const authVerifier = createStaticRemoteAuthVerifier({
+  tokens: new Map([
+    ["fixture-desktop", configuration.desktop],
+    ["fixture-foreign-desktop", configuration.foreignDesktop],
+  ]),
+})
+const relayGuard = new EncryptedRelayGuard(repository, local.relaySequences)
+type HttpEnvironment = Parameters<ReturnType<typeof createRemoteAccessHttpApp>["fetch"]>[1]
+let fetchRequest: (
+  request: Request,
+  environment: HttpEnvironment
+) => Response | Promise<Response> = () => new Response("starting", { status: 503 })
+const server = serve({
+  hostname: "127.0.0.1",
+  port: 0,
+  fetch: (request, environment) => fetchRequest(request, environment),
+})
+await new Promise<void>((resolve) => {
+  if (server.listening) resolve()
+  else server.once("listening", resolve)
+})
+const address = server.address()
+if (!address || typeof address === "string") throw new Error("missing local HTTP listener")
+const origin = `http://127.0.0.1:${address.port}`
+const service = new DeviceAuthorizationService({
+  store,
+  pepper: new Uint8Array(32).fill(47),
+  relayOrigin: origin,
+  now: () => new Date(clock),
+})
+const sockets = new Map<string, Set<{ close(code?: number, reason?: string): void }>>()
+const app = createRemoteAccessHttpApp({
+  authVerifier,
+  pairingService: new PairingService({ repository, pairingCodePepper: local.pairingCodePepper }),
+  relayGuard,
+  relayMailbox: local.relayMailbox,
+  deviceAuthorization: {
+    service,
+    externalOrigin: origin,
+    remoteAddress: (context) => getConnInfo(context).remote.address ?? "unknown",
+  },
+  onBindingRevoked: (binding) => {
+    for (const deviceId of [binding.mobileDeviceId, binding.desktopDeviceId])
+      for (const socket of sockets.get(deviceId) ?? []) socket.close(4003, "binding revoked")
+  },
+})
+const ws = createNodeWebSocket({ app })
+registerDeviceAuthorizationWebSocket(
+  app,
+  ws.upgradeWebSocket,
+  { service, authVerifier, externalOrigin: origin, relayGuard, relayMailbox: local.relayMailbox },
+  sockets
+)
+ws.injectWebSocket(server)
+fetchRequest = (request, environment) => app.fetch(request, environment)
+process.stdout.write(
+  "ewdap-fixture-v1:" + JSON.stringify({ kind: "ready", origin, pid: process.pid }) + "\n"
+)
+let stopped = false
+const stop = async () => {
+  if (stopped) return
+  stopped = true
+  for (const group of sockets.values())
+    for (const socket of group) socket.close(1001, "fixture stopped")
+  for (const socket of ws.wss.clients) socket.terminate()
+  const closed = new Promise<void>((resolve) => server.close(() => resolve()))
+  if ("closeAllConnections" in server) server.closeAllConnections()
+  await closed
+  await Promise.all([postgres?.close(), store.close()])
+  process.exit(0)
+}
+process.on("SIGTERM", () => {
+  void stop()
+})
+for await (const line of iterator) {
+  const input: unknown = JSON.parse(line)
+  const command = z
+    .object({
+      id: z.string(),
+      clock: z.number().optional(),
+      record: z
+        .object({
+          kind: z.enum(["grants", "bindings"]),
+          id: z.string(),
+          change: z.record(z.string(), z.unknown()),
+        })
+        .optional(),
+    })
+    .strict()
+    .parse(input)
+  if (command.clock !== undefined) clock = command.clock
+  if (command.record) {
+    const record = command.record
+    await store.transaction([record.id], async (transaction) => {
+      const previous = z
+        .record(z.string(), z.unknown())
+        .parse(await transaction.get(record.kind, record.id))
+      await transaction.put(record.kind, record.id, { ...previous, ...record.change })
+    })
+  }
+  process.stdout.write("ewdap-fixture-v1:" + JSON.stringify({ kind: "ack", id: command.id }) + "\n")
+}
+await stop()
