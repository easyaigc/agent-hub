@@ -0,0 +1,48 @@
+import { describe, expect, test, vi } from "vitest"
+import { createDesktopUsageReader } from "../../../src/main/remote-access/remote-usage.js"
+
+const target = {
+  agentId: "easywork",
+  hostId: "host",
+  workspaceId: "workspace",
+  runtimeId: "runtime",
+}
+const access = {
+  platformBaseUrl: "https://example.test",
+  accessToken: "fixture-only",
+  userId: "fixture-user",
+}
+
+describe("desktop usage authorization lifetime", () => {
+  test("an invalidated bridge does not read the account service", async () => {
+    const auth = { ensurePlatformAccessContext: vi.fn(async () => access) }
+    const fetchImpl = vi.fn<typeof fetch>()
+    const result = await createDesktopUsageReader(auth, fetchImpl, () => false)(target, "before")
+    expect(result).toMatchObject({ status: "unavailable", reason: "not-authenticated" })
+    expect(auth.ensurePlatformAccessContext).not.toHaveBeenCalled()
+    expect(fetchImpl).not.toHaveBeenCalled()
+  })
+
+  test("a source reply arriving after bridge invalidation cannot expose a balance", async () => {
+    let authorized = true
+    let complete!: (response: Response) => void
+    const fetchImpl = vi.fn<typeof fetch>(
+      () =>
+        new Promise((resolve) => {
+          complete = resolve
+        })
+    )
+    const auth = { ensurePlatformAccessContext: vi.fn(async () => access) }
+    const pending = createDesktopUsageReader(auth, fetchImpl, () => authorized)(target, "during")
+    await vi.waitFor(() => expect(fetchImpl).toHaveBeenCalledOnce())
+    authorized = false
+    complete(new Response(JSON.stringify({ balance: { amount: "12.345", currency: "resource" } })))
+    const result = await pending
+    expect(result).toMatchObject({
+      status: "unavailable",
+      reason: "not-authenticated",
+      requestId: "during",
+    })
+    expect(result).not.toHaveProperty("snapshot")
+  })
+})
