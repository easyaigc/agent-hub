{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local ordinary Codex chat notifications v1",
  "description": "Validate with NativeChatNotificationStore.validateEncoded as well: cross-object targets, ticket/generation/event uniqueness and UTF-8 byte capacity are checked by production code. System submission is not device delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "preferences", "leases", "receipts"],
  "properties": {
    "version": {
      "const": 1
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "leases": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/lease"
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "$ref": "#/$defs/receipt"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "hostId", "workspaceId", "runtimeId"],
      "properties": {
        "agentId": {
          "const": "codex"
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "runtimeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "subject"],
          "properties": {
            "authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f]+$"
            }
          }
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "generation",
        "enabled",
        "kinds",
        "excludedHosts",
        "foregroundBanner",
        "soundEnabled",
        "badgeEnabled",
        "showThreadTitle",
        "timeSensitive",
        "sound",
        "categorySounds"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "approval",
              "question",
              "plan",
              "paused",
              "interrupted",
              "failed",
              "uncertain",
              "completed",
              "connection",
              "stopped"
            ]
          }
        },
        "excludedHosts": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f]+$"
          }
        },
        "foregroundBanner": {
          "type": "boolean"
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "badgeEnabled": {
          "type": "boolean"
        },
        "showThreadTitle": {
          "type": "boolean"
        },
        "timeSensitive": {
          "type": "boolean"
        },
        "sound": {
          "type": "string",
          "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
        },
        "categorySounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "question": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "plan": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "paused": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "interrupted": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "failed": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "uncertain": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "completed": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "connection": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            },
            "stopped": {
              "type": "string",
              "pattern": "^(default|none|[a-zA-Z0-9_-]{1,72}\\.caf)$"
            }
          }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "messageId", "contentVersion"],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contentVersion": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "target", "kind", "occurredAt"],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "kind": {
          "enum": [
            "approval",
            "question",
            "plan",
            "paused",
            "interrupted",
            "failed",
            "uncertain",
            "completed",
            "connection",
            "stopped"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "threadTitle": {
          "type": "string",
          "maxLength": 100
        },
        "taskSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Production validator also rejects whitespace/control/format, doubled/leading/trailing spaces."
        },
        "readTarget": {
          "$ref": "#/$defs/target"
        },
        "readPosition": {
          "$ref": "#/$defs/position"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["readPosition"]
          },
          "then": {
            "required": ["threadId", "readTarget"],
            "properties": {
              "kind": {
                "const": "completed"
              }
            }
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "credentialEpoch", "registrationGeneration", "preferenceRevision"],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "credentialEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "registrationGeneration": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "preferenceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f]+$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "lease", "ticket", "expiresAt", "state", "consumed"],
      "properties": {
        "event": {
          "$ref": "#/$defs/event"
        },
        "lease": {
          "$ref": "#/$defs/lease"
        },
        "ticket": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": ["claimed", "posted", "unknown"]
        },
        "consumed": {
          "type": "boolean"
        }
      }
    }
  }
}
