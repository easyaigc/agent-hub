@@ -0,0 +1,43 @@
+import {
+  parseUsageTarget,
+  usageTargetKey,
+  unavailableUsage,
+  type UsageResponse,
+  type UsageTarget,
+} from "@codex-manage/protocol"
+import { readEasyWorkUsage, type EasyWorkUsageAuth } from "@codex-manage/easywork-adapter"
+import type { RuntimeTarget } from "@easyai-desktop/agent-protocol"
+import { RemoteBridgeError } from "./remote-bridge-codecs.js"
+
+export type RuntimeUsageReader = (target: UsageTarget, requestId: string) => Promise<UsageResponse>
+
+export function createDesktopUsageReader(
+  auth: EasyWorkUsageAuth,
+  fetchImpl: typeof fetch,
+  authorized: () => boolean
+): RuntimeUsageReader {
+  return async (target, requestId) => {
+    if (!authorized()) return unavailableUsage(target, requestId, "not-authenticated")
+    const result = await readEasyWorkUsage(auth, target, requestId, fetchImpl)
+    return authorized() ? result : unavailableUsage(target, requestId, "not-authenticated")
+  }
+}
+
+export async function readRuntimeUsage(
+  current: RuntimeTarget,
+  params: { target: unknown; requestId: string },
+  read?: RuntimeUsageReader
+): Promise<UsageResponse> {
+  const target = parseUsageTarget(params.target)
+  const expected = parseUsageTarget({
+    agentId: "easywork",
+    hostId: current.desktopDeviceId,
+    workspaceId: current.workspaceId,
+    runtimeId: current.runtimeId,
+  })
+  if (usageTargetKey(target) !== usageTargetKey(expected))
+    throw new RemoteBridgeError("target_mismatch", false)
+  return read
+    ? await read(target, params.requestId)
+    : unavailableUsage(target, params.requestId, "unsupported")
+}
