<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.easyai.agenthub.android.acceptance.permission.P9_NATURAL_OBSERVER" />
    <queries>
        <package android:name="com.easyai.agenthub.android.acceptance.coldexaminer" />
        <provider android:authorities="${applicationId}.test.sound-witness" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
    </queries>
    <application>
        <activity android:name="com.agenthub.android.NativeSavedVoicePanelActivity" android:exported="false" />
        <activity android:name="com.agenthub.android.NativeMigrationProvisionalOwnerActivity" android:exported="false"
            android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.agenthub.android.NativeMigrationInboxOwnerActivity" android:exported="false"
            android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" />
        <!-- Fixed same-UID component fixture only. No receiver, provider or production startup hook. -->
        <service android:name="com.agenthub.android.NativeNaturalStoreProbeService"
            android:exported="false" android:process=":p9NaturalStore" />
    </application>
</manifest>
