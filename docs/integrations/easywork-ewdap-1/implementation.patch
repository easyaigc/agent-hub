new file mode 100644
index 0000000..42fc50e
--- /dev/null
+++ b/apps/desktop/src/main/remote-access/desktop-remote-request-journal.ts
@@ -0,0 +1,121 @@
+import { createHash, randomUUID } from "node:crypto"
+import { mkdir, open, readFile, rename } from "node:fs/promises"
+import path from "node:path"
+
+import {
+  agentProtocolV2FailureSchema,
+  agentProtocolV2SuccessSchema,
+  type AgentProtocolV2Failure,
+  type AgentProtocolV2Request,
+  type AgentProtocolV2Success,
+} from "@easyai-desktop/agent-protocol"
+import {
+  canonicalDeviceAuthorizationJson,
+  deviceAuthorizationTargetKey,
+} from "@easyai-desktop/remote-access"
+import { z } from "zod"
+
+type Response = AgentProtocolV2Failure | AgentProtocolV2Success
+const recordsSchema = z.record(
+  z.string(),
+  z
+    .object({
+      intentHash: z.string(),
+      status: z.enum(["dispatching", "completed"]),
+      response: z.union([agentProtocolV2FailureSchema, agentProtocolV2SuccessSchema]).optional(),
+    })
+    .strict()
+)
+/** Adapter for this older base; newer sources can supply their existing durable receipt port. */
+export type DesktopRemoteRequestJournalPort = {
+  execute(request: AgentProtocolV2Request, dispatch: () => Promise<Response>): Promise<Response>
+}
+export class DesktopRemoteRequestJournal implements DesktopRemoteRequestJournalPort {
+  #records?: z.infer<typeof recordsSchema>
+  #queue = Promise.resolve()
+  #running = new Map<string, Promise<Response>>()
+  constructor(private readonly file: string) {}
+  async #serialized<T>(operation: () => Promise<T>): Promise<T> {
+    const current = this.#queue.then(operation, operation)
+    this.#queue = current.then(
+      () => undefined,
+      () => undefined
+    )
+    return await current
+  }
+  async #load() {
+    if (this.#records) return this.#records
+    try {
+      this.#records = recordsSchema.parse(JSON.parse(await readFile(this.file, "utf8")))
+    } catch (error) {
+      if (!(error instanceof Error) || !("code" in error) || error.code !== "ENOENT") throw error
+      this.#records = {}
+    }
+    return this.#records
+  }
+  async #save() {
+    await mkdir(path.dirname(this.file), { recursive: true, mode: 0o700 })
+    const temporary = `${this.file}.${randomUUID()}.tmp`
+    const output = await open(temporary, "wx", 0o600)
+    try {
+      await output.writeFile(JSON.stringify(this.#records))
+      await output.sync()
+    } finally {
+      await output.close()
+    }
+    await rename(temporary, this.file)
+  }
+  async execute(
+    request: AgentProtocolV2Request,
+    dispatch: () => Promise<Response>
+  ): Promise<Response> {
+    const key = JSON.stringify([deviceAuthorizationTargetKey(request.target), request.requestId])
+    const intentHash = createHash("sha256")
+      .update(canonicalDeviceAuthorizationJson(request))
+      .digest("hex")
+    const failure = (code: string, message: string): Response => ({
+      protocolVersion: 2,
+      kind: "response",
+      requestId: request.requestId,
+      ok: false,
+      error: { code, message, retryable: false },
+    })
+    const previous = await this.#serialized(async () => {
+      const records = await this.#load(),
+        entry = records[key]
+      if (entry) {
+        if (entry.intentHash !== intentHash)
+          return failure("REMOTE_OPERATION_CONFLICT", "原操作ID对应不同指令")
+        if (entry.response) return entry.response
+        if (!this.#running.has(key))
+          return failure(
+            "REMOTE_OPERATION_OUTCOME_UNKNOWN",
+            "原指令已派发但结果未确认，请查询原操作状态，不要重新提交模型输入"
+          )
+        return undefined
+      }
+      records[key] = { intentHash, status: "dispatching" }
+      await this.#save()
+      const execution = dispatch()
+        .then(async (response) => {
+          await this.#serialized(async () => {
+            records[key] = { intentHash, status: "completed", response }
+            await this.#save()
+          })
+          return response
+        })
+        .catch(() =>
+          failure("REMOTE_OPERATION_OUTCOME_UNKNOWN", "原指令的派发结果未知，请查询原操作状态")
+        )
+      this.#running.set(key, execution)
+      return undefined
+    })
+    if (previous) return previous
+    const running = this.#running.get(key)!
+    try {
+      return await running
+    } finally {
+      if (this.#running.get(key) === running) this.#running.delete(key)
+    }
+  }
+}
