{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-hub.invalid/android-migration/easywork-business-v1",
  "title": "Android read-only EasyWork import state/catalog v1; graph and origin semantics also require native validation",
  "oneOf": [
    {
      "$ref": "#/definitions/importState"
    },
    {
      "$ref": "#/definitions/catalog"
    }
  ],
  "definitions": {
    "importState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "provider",
        "archiveId",
        "target",
        "requiresPairing",
        "credentialState",
        "preference",
        "candidateOrigins"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "provider": {
          "const": "easywork"
        },
        "archiveId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentId", "hostId", "workspaceId", "runtimeId", "account"],
          "properties": {
            "agentId": {
              "const": "easywork"
            },
            "hostId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "\\S"
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "\\S"
            },
            "runtimeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "\\S"
            },
            "account": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authority", "subject"],
              "properties": {
                "authority": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "requiresPairing": {
          "const": true
        },
        "credentialState": {
          "const": "none"
        },
        "preference": {
          "enum": ["automatic", "lan-only", "relay-only"]
        },
        "candidateOrigins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^(https?|wss?)://[^/?#@]+$"
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "clients"],
      "properties": {
        "version": {
          "const": 1
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "archiveId",
              "originalClient",
              "originalClientSha256",
              "installationArchiveId",
              "credentialName",
              "credentialSha256"
            ],
            "properties": {
              "archiveId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "originalClient": {
                "type": "string",
                "minLength": 1,
                "maxLength": 262144,
                "description": "Serialized closed original client JSON; native parser also enforces256KiB UTF8 and semantic fields."
              },
              "originalClientSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "installationArchiveId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "credentialName": {
                "type": "string",
                "pattern": "^easywork-credential:.+$",
                "maxLength": 8192
              },
              "credentialSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "description": "Native decoder additionally checks <=2MiB UTF8, unique/canonical archive hashes, original descriptor schema, full targets and exact original-installation credential references."
    }
  }
}
