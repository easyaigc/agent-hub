+internal fun p8MenuPixelBudget(phase: String,expected: String,width: Int,height: Int,completed: Set<String>,pixels: Long,bytes: Long): Boolean {
+    val states=mapOf("known-initial-automatic" to "automatic","after-click-and-form-reopen-lan-only" to "lan-only",
+        "after-click-and-form-reopen-relay-only" to "relay-only","after-click-and-form-reopen-automatic" to "automatic")
+    return states[phase]==expected&&phase !in completed&&completed.size<4&&completed.all {it in states}&&width in 1..4096&&height in 1..4096&&
+        width.toLong()*height<=1_048_576&&pixels in 0..4_194_304&&pixels+width.toLong()*height<=4_194_304&&bytes in 0..8_388_608
+}
+internal class P8PixelDelivery<T: Any>(private val dispose: (T)->Unit){
+    private var closed=false;private var offered=false;private var value: T?=null
+    fun offer(next: T){val accepted=synchronized(this){if(closed||offered)false else{offered=true;value=next;true}};if(!accepted)dispose(next)}
+    fun take(): T=synchronized(this){check(!closed&&offered);closed=true;checkNotNull(value).also {value=null}}
+    fun close(){val discarded=synchronized(this){closed=true;value.also {value=null}};discarded?.let(dispose)}
+}
+internal class P8BoundedPng(private val maxBytes: Int,private val withinBudget: ()->Boolean): java.io.OutputStream(){
+    private val data=java.io.ByteArrayOutputStream()
+    override fun write(value: Int){check(withinBudget()&&data.size()<maxBytes);data.write(value)}
+    override fun write(bytes: ByteArray,offset: Int,length: Int){check(offset>=0&&length>=0&&offset<=bytes.size-length);check(withinBudget()&&length<=maxBytes-data.size());data.write(bytes,offset,length)}
+    fun bytes(): ByteArray {check(withinBudget());return data.toByteArray()}
+}
