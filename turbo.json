{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["HOST_AGENT_BIND_ADDRESS", "HOST_AGENT_PORT", "RELAY_BIND_ADDRESS", "RELAY_PORT"]
    }
  }
}
