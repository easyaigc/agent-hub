+import { x25519 } from "@noble/curves/ed25519.js"
+import { sha256 } from "@noble/hashes/sha2.js"
+
+import { decodeBase64Url, encodeBase64Url } from "./e2ee.js"
+
+const encoder = new TextEncoder()
+const concat = (...values: Uint8Array[]): Uint8Array<ArrayBuffer> => {
+  const result = new Uint8Array(values.reduce((length, value) => length + value.length, 0))
+  let offset = 0
+  for (const value of values) {
+    result.set(value, offset)
+    offset += value.length
+  }
+  return result
+}
+const uint32 = (value: number) => {
+  const result = new Uint8Array(4)
+  new DataView(result.buffer).setUint32(0, value)
+  return result
+}
+function deriveJweKey(secret: Uint8Array): Uint8Array {
+  const algorithm = encoder.encode("A256GCM")
+  // RFC 7518 4.6.2: Concat KDF, empty PartyU/PartyV, 256-bit key length.
+  return sha256(
+    concat(
+      uint32(1),
+      secret,
+      uint32(algorithm.length),
+      algorithm,
+      uint32(0),
+      uint32(0),
+      uint32(256)
+    )
+  )
+}
+async function aesKey(secret: Uint8Array) {
+  const derived = deriveJweKey(secret)
+  try {
+    return await crypto.subtle.importKey("raw", derived.buffer as ArrayBuffer, "AES-GCM", false, [
+      "encrypt",
+      "decrypt",
+    ])
+  } finally {
+    derived.fill(0)
+    secret.fill(0)
+  }
+}
+
+/** Standard compact JWE ECDH-ES/A256GCM, not the application's binding HKDF. */
+export async function sealDeviceAuthorizationDelivery(
+  publicKey: string,
+  deliveryId: string,
+  payload: unknown
+): Promise<string> {
+  const recipient = decodeBase64Url(publicKey)
+  if (recipient.length !== 32) throw new Error("invalid X25519 recipient key")
+  const ephemeral = x25519.keygen()
+  const key = await aesKey(x25519.getSharedSecret(ephemeral.secretKey, recipient))
+  ephemeral.secretKey.fill(0)
+  const header = encodeBase64Url(
+    encoder.encode(
+      JSON.stringify({
+        alg: "ECDH-ES",
+        enc: "A256GCM",
+        typ: "ewdap+jwe",
+        version: 1,
+        deliveryId,
+        epk: { kty: "OKP", crv: "X25519", x: encodeBase64Url(ephemeral.publicKey) },
+      })
+    )
+  )
+  const iv = crypto.getRandomValues(new Uint8Array(12))
+  const clear = encoder.encode(JSON.stringify(payload))
+  try {
+    const ciphertext = new Uint8Array(
+      await crypto.subtle.encrypt(
+        { name: "AES-GCM", iv, additionalData: encoder.encode(header), tagLength: 128 },
+        key,
+        clear
+      )
+    )
+    return [
+      header,
+      "",
+      encodeBase64Url(iv),
+      encodeBase64Url(ciphertext.slice(0, -16)),
+      encodeBase64Url(ciphertext.slice(-16)),
+    ].join(".")
+  } finally {
+    clear.fill(0)
+  }
+}
+
+export async function openDeviceAuthorizationDelivery(
+  privateKey: string,
+  delivery: string,
+  expectedDeliveryId: string
+): Promise<unknown> {
+  const parts = delivery.split(".")
+  if (parts.length !== 5 || parts[1] !== "") throw new Error("invalid compact JWE")
+  const [protectedHeader, , encodedIv, encodedCiphertext, encodedTag] = parts as [
+    string,
+    string,
+    string,
+    string,
+    string,
+  ]
+  const header: unknown = JSON.parse(new TextDecoder().decode(decodeBase64Url(protectedHeader)))
+  if (
+    typeof header !== "object" ||
+    header === null ||
+    !("alg" in header) ||
+    header.alg !== "ECDH-ES" ||
+    !("enc" in header) ||
+    header.enc !== "A256GCM" ||
+    !("typ" in header) ||
+    header.typ !== "ewdap+jwe" ||
+    !("version" in header) ||
+    header.version !== 1 ||
+    !("deliveryId" in header) ||
+    header.deliveryId !== expectedDeliveryId ||
+    !("epk" in header)
+  )
+    throw new Error("invalid JWE protection")
+  const epk = header.epk
+  if (
+    typeof epk !== "object" ||
+    epk === null ||
+    !("kty" in epk) ||
+    epk.kty !== "OKP" ||
+    !("crv" in epk) ||
+    epk.crv !== "X25519" ||
+    !("x" in epk) ||
+    typeof epk.x !== "string" ||
+    "d" in epk
+  )
+    throw new Error("invalid ephemeral public key")
+  if ("apu" in header || "apv" in header || "crit" in header)
+    throw new Error("unsupported JWE header")
+  const iv = new Uint8Array(decodeBase64Url(encodedIv)),
+    tag = decodeBase64Url(encodedTag)
+  if (iv.length !== 12 || tag.length !== 16) throw new Error("invalid JWE IV/tag")
+  const key = await aesKey(
+    x25519.getSharedSecret(decodeBase64Url(privateKey), decodeBase64Url(epk.x))
+  )
+  const clear = new Uint8Array(
+    await crypto.subtle.decrypt(
+      { name: "AES-GCM", iv, additionalData: encoder.encode(protectedHeader), tagLength: 128 },
+      key,
+      concat(decodeBase64Url(encodedCiphertext), tag)
+    )
+  )
+  try {
+    return JSON.parse(new TextDecoder().decode(clear)) as unknown
+  } finally {
+    clear.fill(0)
+  }
+}
