<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>application-identifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <!-- Older simulator builds used this legacy group even for custom bundle IDs.
       Keep it readable on upgrade; new items retain the app-specific default.
       Device and isolated R2 targets use their separate entitlements. -->
  <key>keychain-access-groups</key><array><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string><string>com.codexmanage.ios</string></array>
<key>com.apple.security.application-groups</key><array><string>group.$(NOTIFICATION_APP_BUNDLE_ID).notifications</string></array>
</dict></plist>
