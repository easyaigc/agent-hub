@@ -0,0 +1,15 @@
+/** Stable JSON intent/identity serialization, including every declared target field. */
+export function canonicalDeviceAuthorizationJson(value: unknown): string {
+  if (Array.isArray(value))
+    return `[${value.map((item) => (item === undefined ? "null" : canonicalDeviceAuthorizationJson(item))).join(",")}]`
+  if (value !== null && typeof value === "object") {
+    return `{${Object.entries(value)
+      .filter(([, item]) => item !== undefined)
+      .sort(([left], [right]) => (left < right ? -1 : left > right ? 1 : 0))
+      .map(([key, item]) => `${JSON.stringify(key)}:${canonicalDeviceAuthorizationJson(item)}`)
+      .join(",")}}`
+  }
+  const serialized = JSON.stringify(value)
+  if (serialized === undefined) throw new Error("device authorization intent must be JSON")
+  return serialized
+}
